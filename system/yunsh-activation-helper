def socket_command(name, payload):
    path = SOCKETS[name]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(30)
            sock.connect(path)
            sock.sendall((json.dumps(payload) + "\n").encode())
            data = b""
            while not data.endswith(b"\n"):
                chunk = sock.recv(65536)
                if not chunk:
                    break
                data += chunk
        return json.loads(data.decode() or "{}")
    except Exception as exc:
        return {"success": False, "error": str(exc)}


def connect_wifi(payload):
    ssid = payload.get("ssid", "")
    password = payload.get("password", "")
    if not ssid:
        return {"success": False, "error": "SSID is required"}
    cmd = ["nmcli", "device", "wifi", "connect", ssid]
    if password:
        cmd += ["password", password]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        if result.returncode == 0:
            return {"success": True, "ssid": ssid}
        return {"success": False, "error": result.stderr.strip() or result.stdout.strip()}
    except Exception as exc:
        return {"success": False, "error": str(exc)}


def configure_activation(payload):
    """Persist first-run preferences without allowing arbitrary commands."""
    password = str(payload.get("password", ""))
    language = str(payload.get("language", "简体中文"))
    keyboard = str(payload.get("keyboard", "拼音"))
    allowed_languages = {"简体中文", "English", "日本語", "한국어"}
    if language not in allowed_languages:
        return {"success": False, "error": "Unsupported language"}
    if password and (
        len(password) < 4
        or len(password) > 128
        or "\n" in password
        or "\r" in password
        or "\x00" in password
    ):
        return {"success": False, "error": "Password must contain 4–128 valid characters"}
    try:
        os.makedirs(YUNSH_CONFIG_DIR, exist_ok=True)
        fd, temp_path = tempfile.mkstemp(prefix="language.", dir=YUNSH_CONFIG_DIR)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(f"language={language}\nkeyboard={keyboard}\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, os.path.join(YUNSH_CONFIG_DIR, "language.conf"))
        if password:
            changed = subprocess.run(
                ["chpasswd"],
                input=f"yunsh:{password}\n",
                capture_output=True,
                text=True,
                timeout=10,
            )
            if changed.returncode != 0:
                return {
                    "success": False,
                    "error": changed.stderr.strip() or "Could not update the account password",
                }
        return {"success": True}
    except Exception as exc:
        return {"success": False, "error": str(exc)}


def set_glasses_brightness(payload):
    try:
        value = max(0, min(100, int(payload.get("value"))))
        temp_path = GLASSES_CONTROL_PATH + ".tmp"
        with open(temp_path, "w", encoding="utf-8") as handle:
            json.dump({"brightness": value}, handle)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, GLASSES_CONTROL_PATH)
        return {"success": True, "brightness": value}
    except (OSError, TypeError, ValueError) as exc:
        return {"success": False, "error": str(exc)}


def set_volume(payload):
    try:
        value = max(0, min(100, int(payload.get("value"))))
    except (TypeError, ValueError) as exc:
        return {"success": False, "error": str(exc)}
    commands = (
        ["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{value}%"],
        ["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{value}%"],
        ["amixer", "sset", "Master", f"{value}%"],
    )
    errors = []
    for command in commands:
        try:
            result = subprocess.run(
                command, capture_output=True, text=True, timeout=10
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            errors.append(str(exc))
            continue
        if result.returncode == 0:
            return {"success": True, "volume": value}
        errors.append(result.stderr.strip() or result.stdout.strip())
    return {
        "success": False,
        "error": next((error for error in errors if error), "No audio output is available"),
    }


def read_json(path, default=None):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return default or {}


def sanitize_spatial_preferences(payload):
    """Accept only known display preferences and clamp numeric calibration."""
    result = dict(SPATIAL_DEFAULTS)
    for key, default in SPATIAL_DEFAULTS.items():
        value = payload.get(key, default)
        if isinstance(default, bool):
            if isinstance(value, bool):
                result[key] = value
            continue
        try:
            number = float(value)
        except (TypeError, ValueError):
            continue
        if not math.isfinite(number):
            continue
        minimum, maximum = SPATIAL_RANGES[key]
        result[key] = max(minimum, min(maximum, number))
    return result


def load_spatial_preferences():
    stored = read_json(SPATIAL_PREFERENCES_PATH, {})
    result = sanitize_spatial_preferences(stored)
    result["success"] = True
    return result


def save_spatial_preferences(payload):
    preferences = sanitize_spatial_preferences(payload)
    try:
        os.makedirs(YUNSH_CONFIG_DIR, exist_ok=True)
        fd, temp_path = tempfile.mkstemp(
            prefix="spatial-display.", dir=YUNSH_CONFIG_DIR
        )
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(
                preferences,
                handle,
                ensure_ascii=False,
                sort_keys=True,
                indent=2,
            )
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, SPATIAL_PREFERENCES_PATH)
        return {"success": True, **preferences}
    except OSError as exc:
        return {"success": False, "error": str(exc)}


def atomic_write_json(path, payload):
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    fd, temp_path = tempfile.mkstemp(prefix=os.path.basename(path) + ".", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, ensure_ascii=False, sort_keys=True, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, path)
    except Exception:
        try:
            os.unlink(temp_path)
        except OSError:
            pass
        raise


def load_comfort_dna():
    stored = read_json(COMFORT_DNA_PATH, {})
    profile = stored.get("profile", "balanced")
    if profile not in COMFORT_PROFILES:
        profile = "balanced"
    return {
        "success": True,
        "configured": stored.get("configured") is True,
        "skipped": stored.get("skipped") is True,
        "profile": profile,
        **COMFORT_PROFILES[profile],
    }


def save_comfort_dna(payload):
    action = str(payload.get("action", "apply"))
    if action == "skip":
        record = {
            "configured": False,
            "skipped": True,
            "profile": "balanced",
            "updatedAt": datetime.now(timezone.utc).isoformat(),
        }
        try:
            atomic_write_json(COMFORT_DNA_PATH, record)
            return {"success": True, **record}
        except OSError as exc:
            return {"success": False, "error": str(exc)}

    profile = str(payload.get("profile", "balanced"))
    if profile not in COMFORT_PROFILES:
        return {"success": False, "error": "Unsupported comfort profile"}

    profile_values = COMFORT_PROFILES[profile]
    spatial = load_spatial_preferences()
    spatial.pop("success", None)
    spatial.update(
        {
            "trackingSmoothing": profile_values["trackingSmoothing"],
            "fieldOfView": profile_values["fieldOfView"],
            "reduceMotion": profile_values["reduceMotion"],
        }
    )
    spatial_result = save_spatial_preferences(spatial)
    if not spatial_result.get("success"):
        return spatial_result

    record = {
        "configured": True,
        "skipped": False,
        "profile": profile,
        "updatedAt": datetime.now(timezone.utc).isoformat(),
    }
    try:
        atomic_write_json(COMFORT_DNA_PATH, record)
        return {"success": True, **record, **profile_values}
    except OSError as exc:
        return {"success": False, "error": str(exc)}


def clamp_number(value, minimum, maximum, default):
    try:
        number = float(value)
    except (TypeError, ValueError):
        return default
    if not math.isfinite(number):
        return default
    return max(minimum, min(maximum, number))


def sanitize_capsule_window(item):
    if not isinstance(item, dict):
        return None
    app_id = str(item.get("appId", ""))
    if app_id not in CAPSULE_ALLOWED_APPS:
        return None
    placement = str(item.get("spatialPlacement", "front"))
    if placement not in {"front", "left", "right", "far"}:
        placement = "front"
    pin_mode = str(item.get("pinMode", "pinned"))
    if pin_mode not in {"pinned", "following"}:
        pin_mode = "pinned"
    result = {
        "appId": app_id,
        "x": clamp_number(item.get("x"), -1920, 3840, 80),
        "y": clamp_number(item.get("y"), -1080, 2160, 60),
        "width": clamp_number(item.get("width"), 320, 1600, 880),
        "height": clamp_number(item.get("height"), 240, 1000, 640),
        "visible": item.get("visible") is True,
        "minimized": item.get("minimized") is True,
        "spatialPlacement": placement,
        "pinMode": pin_mode,
        "order": int(clamp_number(item.get("order"), 0, 1000, 0)),
    }
    app_state = item.get("state")
    if app_id == "browser" and isinstance(app_state, dict):
        url = str(app_state.get("url", ""))[:2048]
        if url.startswith(("https://", "http://")):
            result["state"] = {"url": url}
    return result


def safe_capsule_name(value):
    name = re.sub(r"[\x00-\x1f/\\\\]+", " ", str(value or "")).strip()
    name = re.sub(r"\s+", " ", name)
    return name[:48] or "我的空间"


def capsule_path_from_filename(filename):
    candidate = os.path.basename(str(filename or ""))
    if candidate != filename or not candidate.endswith(SPACE_CAPSULE_EXTENSION):
        return None
    base = os.path.realpath(SPACE_CAPSULE_DIR)
    path = os.path.realpath(os.path.join(base, candidate))
    if not path.startswith(base + os.sep):
        return None
    return path


def export_space_capsule(payload):
    windows = []
    raw_windows = payload.get("windows", [])
    if not isinstance(raw_windows, list):
        return {"success": False, "error": "Workspace windows must be a list"}
    for item in raw_windows[:20]:
        sanitized = sanitize_capsule_window(item)
        if sanitized:
            windows.append(sanitized)
    if not windows:
        return {"success": False, "error": "Workspace has no restorable windows"}

    name = safe_capsule_name(payload.get("name"))
    active_app = str(payload.get("activeAppId", ""))
    if active_app not in CAPSULE_ALLOWED_APPS:
        active_app = ""
    created_at = datetime.now(timezone.utc)
    capsule = {
        "format": "yunsh-space-capsule",
        "schemaVersion": SPACE_CAPSULE_SCHEMA,
        "product": "YUNSH OS",
        "name": name,
        "createdAt": created_at.isoformat(),
        "activeAppId": active_app,
        "windows": windows,
    }
    filename = (
        "YUNSH-SpaceCapsule-"
        + created_at.strftime("%Y%m%d-%H%M%S-%f")
        + SPACE_CAPSULE_EXTENSION
    )
    path = os.path.join(SPACE_CAPSULE_DIR, filename)
    try:
        atomic_write_json(path, capsule)
        os.chmod(path, 0o644)
        try:
            home_owner = os.stat(YUNSH_HOME_DIR)
            os.chown(path, home_owner.st_uid, home_owner.st_gid)
        except OSError:
            pass
        return {
            "success": True,
            "filename": filename,
            "path": path,
            "name": name,
            "createdAt": capsule["createdAt"],
            "windowCount": len(windows),
        }
    except OSError as exc:
        return {"success": False, "error": str(exc)}


def load_space_capsule(payload):
    path = capsule_path_from_filename(payload.get("filename"))
    if not path:
        return {"success": False, "error": "Invalid capsule filename"}
    try:
        if os.path.getsize(path) > 1024 * 1024:
            return {"success": False, "error": "SpaceCapsule is too large"}
    except OSError:
        return {"success": False, "error": "SpaceCapsule was not found"}
    stored = read_json(path, None)
    if not isinstance(stored, dict) or stored.get("format") != "yunsh-space-capsule":
        return {"success": False, "error": "Invalid SpaceCapsule format"}
    if stored.get("schemaVersion") != SPACE_CAPSULE_SCHEMA:
        return {"success": False, "error": "Unsupported SpaceCapsule version"}
    windows = []
    raw_windows = stored.get("windows", [])
    if not isinstance(raw_windows, list):
        return {"success": False, "error": "SpaceCapsule windows are invalid"}
    for item in raw_windows[:20]:
        sanitized = sanitize_capsule_window(item)
        if sanitized:
            windows.append(sanitized)
    if not windows:
        return {"success": False, "error": "SpaceCapsule contains no supported windows"}
    active_app = str(stored.get("activeAppId", ""))
    if active_app not in CAPSULE_ALLOWED_APPS:
        active_app = ""
    return {
        "success": True,
        "capsule": {
            "format": "yunsh-space-capsule",
            "schemaVersion": SPACE_CAPSULE_SCHEMA,
            "name": safe_capsule_name(stored.get("name")),
            "createdAt": str(stored.get("createdAt", "")),
            "activeAppId": active_app,
            "windows": windows,
        },
    }


def list_space_capsules():
    capsules = []
    try:
        os.makedirs(SPACE_CAPSULE_DIR, exist_ok=True)
        for filename in os.listdir(SPACE_CAPSULE_DIR):
            if not filename.endswith(SPACE_CAPSULE_EXTENSION):
                continue
            path = capsule_path_from_filename(filename)
            try:
                oversized = not path or os.path.getsize(path) > 1024 * 1024
            except OSError:
                oversized = True
            if oversized:
                continue
            stored = read_json(path, None)
            if not isinstance(stored, dict) or stored.get("format") != "yunsh-space-capsule":
                continue
            capsules.append(
                {
                    "filename": filename,
                    "name": safe_capsule_name(stored.get("name")),
                    "createdAt": str(stored.get("createdAt", "")),
                    "windowCount": min(
                        len(stored.get("windows", []))
                        if isinstance(stored.get("windows"), list)
                        else 0,
                        20,
                    ),
                    "path": path,
                }
            )
    except OSError as exc:
        return {"success": False, "error": str(exc), "capsules": []}
    capsules.sort(key=lambda item: item["createdAt"], reverse=True)
    return {"success": True, "capsules": capsules[:50]}


def update_response(action, payload):
    command = {
        "/api/update-status": "get_status",
        "/api/update-check": "check",
        "/api/update-download": "start_download",
        "/api/update-cancel": "cancel",
    }.get(action)
    if action == "/api/update-config":
        requested = payload.get("action", "")
        if requested == "set_auto_update" or "autoUpdate" in payload:
            command = "set_auto_update"
            payload["auto_update"] = payload.get("value", payload.get("autoUpdate", True))
        elif requested == "set_wifi_only" or "wifiOnly" in payload:
            command = "set_wifi_only"
            payload["wifi_only"] = payload.get("value", payload.get("wifiOnly", True))
        elif requested == "set_channel":
            command = "set_channel"
        elif requested == "set_allow_major_update":
            command = "set_allow_major_update"
        else:
            command = "get_config"
    result = socket_command("update", {"action": command or "get_status", **payload})
    return {
        **result,
        "currentVersion": result.get("current_version", ""),
        "latestVersion": result.get("latest_version", ""),
        "updateAvailable": result.get("update_available", False),
        "autoUpdate": result.get("auto_update", False),
        "wifiOnly": result.get("wifi_only", True),
        "lastCheckTime": result.get("last_check_ts", ""),
        "changelog": result.get("changelog", ""),
        "state": result.get("state", "idle"),
        "progress": result.get("progress_pct", 0),
        "error": result.get("error"),
        "rebootRequired": result.get("reboot_required", False),
    }


class Handler(BaseHTTPRequestHandler):
    def _payload(self):
        length = int(self.headers.get("Content-Length", "0"))
        try:
            return json.loads(self.rfile.read(length) or b"{}")
        except ValueError:
            return {}

    def _send(self, result, status=200):
        body = json.dumps(result, ensure_ascii=False).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.startswith("/api/update-"):
            self._send(update_response(self.path, {}))
        elif self.path == "/api/network-status":
            self._send(read_json("/tmp/yunsh-network-status.json", {"connected": False}))
        elif self.path == "/api/bluetooth-status":
            self._send(read_json("/tmp/yunsh-bluetooth-status.json", {"powered": False}))
        elif self.path == "/api/glasses-status":
            self._send(read_json(GLASSES_STATUS_PATH, {"connected": False}))
        elif self.path == "/api/power-status":
            self._send(read_json("/tmp/yunsh-power-status.json", {"available": False}))
        elif self.path == "/api/spatial-preferences":
            self._send(load_spatial_preferences())
        elif self.path == "/api/comfort-dna":
            self._send(load_comfort_dna())
        elif self.path == "/api/space-capsules":
            self._send(list_space_capsules())
        else:
            self._send({"success": True, "message": "YUNSH local API"})

    def do_POST(self):
        payload = self._payload()
        if self.path.startswith("/api/update-"):
            result = update_response(self.path, payload)
        elif self.path == "/api/network":
            result = connect_wifi(payload) if payload.get("command") == "connect" else socket_command("network", payload)
        elif self.path == "/api/bluetooth":
            result = socket_command("bluetooth", payload)
        elif self.path == "/api/factory-reset":
            try:
                subprocess.Popen(
                    ["/usr/bin/yunsh-factory-reset"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
                result = {"success": True, "message": "factory reset started"}
            except OSError as exc:
                result = {"success": False, "error": str(exc)}
        elif self.path == "/api/glasses":
            if payload.get("action") == "set_brightness":
                result = set_glasses_brightness(payload)
            else:
                result = {"success": False, "error": "Unsupported glasses action"}
        elif self.path == "/api/audio":
            if payload.get("action") == "set_volume":
                result = set_volume(payload)
            else:
                result = {"success": False, "error": "Unsupported audio action"}
        elif self.path == "/api/spatial-preferences":
            result = save_spatial_preferences(payload)
        elif self.path == "/api/comfort-dna":
            result = save_comfort_dna(payload)
        elif self.path == "/api/space-capsules":
            action = payload.get("action")
            if action == "export":
                result = export_space_capsule(payload)
            elif action == "load":
                result = load_space_capsule(payload)
            else:
                result = {"success": False, "error": "Unsupported SpaceCapsule action"}
        else:
            action = payload.get("action")
            if action == "connect_wifi":
                result = connect_wifi(payload)
            elif action == "configure_activation":
                result = configure_activation(payload)
            else:
                result = {"success": action == "ping"}
        self._send(result)

    def log_message(self, _format, *_args):
        return


if __name__ == "__main__":
    ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()
