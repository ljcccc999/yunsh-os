#!/usr/bin/env python3
"""HTTP bridge used by the QML UI for privileged local services."""

import json
import math
import os
import socket
import subprocess
import tempfile
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOST = "127.0.0.1"
PORT = 8591
YUNSH_CONFIG_DIR = os.environ.get("YUNSH_CONFIG_DIR", "/etc/yunsh")
GLASSES_STATUS_PATH = os.environ.get(
    "YUNSH_GLASSES_STATUS_PATH", "/tmp/yunsh-glasses-status.json"
)
GLASSES_CONTROL_PATH = os.environ.get(
    "YUNSH_GLASSES_CONTROL_PATH", "/tmp/yunsh-glasses-control.json"
)
SOCKETS = {
    "network": "/tmp/yunsh-network.sock",
    "bluetooth": "/tmp/yunsh-bluetooth.sock",
    "update": "/tmp/yunsh-update.sock",
}
SPATIAL_PREFERENCES_PATH = os.path.join(
    YUNSH_CONFIG_DIR, "spatial-display.json"
)
SPATIAL_DEFAULTS = {
    "stereoEnabled": True,
    "ipdMm": 63.0,
    "eyeShiftPx": 0.0,
    "fieldOfView": 50.0,
    "trackingSmoothing": 0.35,
    "reduceMotion": False,
    "reduceTransparency": False,
    "highContrast": False,
    "focusMode": False,
}
SPATIAL_RANGES = {
    "ipdMm": (50.0, 75.0),
    "eyeShiftPx": (-40.0, 40.0),
    "fieldOfView": (30.0, 80.0),
    "trackingSmoothing": (0.0, 0.9),
}


def socket_command(name, payload):
    path = SOCKETS[name]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(30)
            sock.connect(path)
            sock.sendall((json.dumps(payload) + "\n").encode())
            data = b""
            while not data.endswith(b"\n"):
                chunk = sock.recv(65536)
                if not chunk:
                    break
                data += chunk
        return json.loads(data.decode() or "{}")
    except Exception as exc:
        return {"success": False, "error": str(exc)}


def connect_wifi(payload):
    ssid = payload.get("ssid", "")
    password = payload.get("password", "")
    if not ssid:
        return {"success": False, "error": "SSID is required"}
    cmd = ["nmcli", "device", "wifi", "connect", ssid]
    if password:
        cmd += ["password", password]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        if result.returncode == 0:
            return {"success": True, "ssid": ssid}
        return {"success": False, "error": result.stderr.strip() or result.stdout.strip()}
    except Exception as exc:
        return {"success": False, "error": str(exc)}


def configure_activation(payload):
    """Persist first-run preferences without allowing arbitrary commands."""
    password = str(payload.get("password", ""))
    language = str(payload.get("language", "简体中文"))
    keyboard = str(payload.get("keyboard", "拼音"))
    allowed_languages = {"简体中文", "English", "日本語", "한국어"}
    if language not in allowed_languages:
        return {"success": False, "error": "Unsupported language"}
    if password and (
        len(password) < 4
        or len(password) > 128
        or "\n" in password
        or "\r" in password
        or "\x00" in password
    ):
        return {"success": False, "error": "Password must contain 4–128 valid characters"}
    try:
        os.makedirs(YUNSH_CONFIG_DIR, exist_ok=True)
        fd, temp_path = tempfile.mkstemp(prefix="language.", dir=YUNSH_CONFIG_DIR)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(f"language={language}\nkeyboard={keyboard}\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, os.path.join(YUNSH_CONFIG_DIR, "language.conf"))
        if password:
            changed = subprocess.run(
                ["chpasswd"],
                input=f"yunsh:{password}\n",
                capture_output=True,
                text=True,
                timeout=10,
            )
            if changed.returncode != 0:
                return {
                    "success": False,
                    "error": changed.stderr.strip() or "Could not update the account password",
                }
        return {"success": True}
    except Exception as exc:
        return {"success": False, "error": str(exc)}


def set_glasses_brightness(payload):
    try:
        value = max(0, min(100, int(payload.get("value"))))
        temp_path = GLASSES_CONTROL_PATH + ".tmp"
        with open(temp_path, "w", encoding="utf-8") as handle:
            json.dump({"brightness": value}, handle)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, GLASSES_CONTROL_PATH)
        return {"success": True, "brightness": value}
    except (OSError, TypeError, ValueError) as exc:
        return {"success": False, "error": str(exc)}


def set_volume(payload):
    try:
        value = max(0, min(100, int(payload.get("value"))))
    except (TypeError, ValueError) as exc:
        return {"success": False, "error": str(exc)}
    commands = (
        ["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{value}%"],
        ["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{value}%"],
        ["amixer", "sset", "Master", f"{value}%"],
    )
    errors = []
    for command in commands:
        try:
            result = subprocess.run(
                command, capture_output=True, text=True, timeout=10
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            errors.append(str(exc))
            continue
        if result.returncode == 0:
            return {"success": True, "volume": value}
        errors.append(result.stderr.strip() or result.stdout.strip())
    return {
        "success": False,
        "error": next((error for error in errors if error), "No audio output is available"),
    }


def read_json(path, default=None):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return default or {}


def sanitize_spatial_preferences(payload):
    """Accept only known display preferences and clamp numeric calibration."""
    result = dict(SPATIAL_DEFAULTS)
    for key, default in SPATIAL_DEFAULTS.items():
        value = payload.get(key, default)
        if isinstance(default, bool):
            if isinstance(value, bool):
                result[key] = value
            continue
        try:
            number = float(value)
        except (TypeError, ValueError):
            continue
        if not math.isfinite(number):
            continue
        minimum, maximum = SPATIAL_RANGES[key]
        result[key] = max(minimum, min(maximum, number))
    return result


def load_spatial_preferences():
    stored = read_json(SPATIAL_PREFERENCES_PATH, {})
    result = sanitize_spatial_preferences(stored)
    result["success"] = True
    return result


def save_spatial_preferences(payload):
    preferences = sanitize_spatial_preferences(payload)
    try:
        os.makedirs(YUNSH_CONFIG_DIR, exist_ok=True)
        fd, temp_path = tempfile.mkstemp(
            prefix="spatial-display.", dir=YUNSH_CONFIG_DIR
        )
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(
                preferences,
                handle,
                ensure_ascii=False,
                sort_keys=True,
                indent=2,
            )
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, SPATIAL_PREFERENCES_PATH)
        return {"success": True, **preferences}
    except OSError as exc:
        return {"success": False, "error": str(exc)}


def update_response(action, payload):
    command = {
        "/api/update-status": "get_status",
        "/api/update-check": "check",
        "/api/update-download": "start_download",
        "/api/update-cancel": "cancel",
    }.get(action)
    if action == "/api/update-config":
        requested = payload.get("action", "")
        if requested == "set_auto_update" or "autoUpdate" in payload:
            command = "set_auto_update"
            payload["auto_update"] = payload.get("value", payload.get("autoUpdate", True))
        elif requested == "set_wifi_only" or "wifiOnly" in payload:
            command = "set_wifi_only"
            payload["wifi_only"] = payload.get("value", payload.get("wifiOnly", True))
        elif requested == "set_channel":
            command = "set_channel"
        elif requested == "set_allow_major_update":
            command = "set_allow_major_update"
        else:
            command = "get_config"
    result = socket_command("update", {"action": command or "get_status", **payload})
    return {
        **result,
        "currentVersion": result.get("current_version", ""),
        "latestVersion": result.get("latest_version", ""),
        "updateAvailable": result.get("update_available", False),
        "autoUpdate": result.get("auto_update", False),
        "wifiOnly": result.get("wifi_only", True),
        "lastCheckTime": result.get("last_check_ts", ""),
        "changelog": result.get("changelog", ""),
        "state": result.get("state", "idle"),
        "progress": result.get("progress_pct", 0),
        "error": result.get("error"),
        "rebootRequired": result.get("reboot_required", False),
    }


class Handler(BaseHTTPRequestHandler):
    def _payload(self):
        length = int(self.headers.get("Content-Length", "0"))
        try:
            return json.loads(self.rfile.read(length) or b"{}")
        except ValueError:
            return {}

    def _send(self, result, status=200):
        body = json.dumps(result, ensure_ascii=False).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.startswith("/api/update-"):
            self._send(update_response(self.path, {}))
        elif self.path == "/api/network-status":
            self._send(read_json("/tmp/yunsh-network-status.json", {"connected": False}))
        elif self.path == "/api/bluetooth-status":
            self._send(read_json("/tmp/yunsh-bluetooth-status.json", {"powered": False}))
        elif self.path == "/api/glasses-status":
            self._send(read_json(GLASSES_STATUS_PATH, {"connected": False}))
        elif self.path == "/api/power-status":
            self._send(read_json("/tmp/yunsh-power-status.json", {"available": False}))
        elif self.path == "/api/spatial-preferences":
            self._send(load_spatial_preferences())
        else:
            self._send({"success": True, "message": "YUNSH local API"})

    def do_POST(self):
        payload = self._payload()
        if self.path.startswith("/api/update-"):
            result = update_response(self.path, payload)
        elif self.path == "/api/network":
            result = connect_wifi(payload) if payload.get("command") == "connect" else socket_command("network", payload)
        elif self.path == "/api/bluetooth":
            result = socket_command("bluetooth", payload)
        elif self.path == "/api/factory-reset":
            try:
                subprocess.Popen(
                    ["/usr/bin/yunsh-factory-reset"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
                result = {"success": True, "message": "factory reset started"}
            except OSError as exc:
                result = {"success": False, "error": str(exc)}
        elif self.path == "/api/glasses":
            if payload.get("action") == "set_brightness":
                result = set_glasses_brightness(payload)
            else:
                result = {"success": False, "error": "Unsupported glasses action"}
        elif self.path == "/api/audio":
            if payload.get("action") == "set_volume":
                result = set_volume(payload)
            else:
                result = {"success": False, "error": "Unsupported audio action"}
        elif self.path == "/api/spatial-preferences":
            result = save_spatial_preferences(payload)
        else:
            action = payload.get("action")
            if action == "connect_wifi":
                result = connect_wifi(payload)
            elif action == "configure_activation":
                result = configure_activation(payload)
            else:
                result = {"success": action == "ping"}
        self._send(result)

    def log_message(self, _format, *_args):
        return


if __name__ == "__main__":
    ThreadingHTTPServer((HOST, PORT), Handler).serve_forever()
