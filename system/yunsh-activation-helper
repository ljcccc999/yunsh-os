def socket_command(name, payload):
    path = SOCKETS[name]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            # Wi-Fi association plus DHCP and one stale-profile retry can take
            # longer than a simple status command on congested networks.
            sock.settimeout(120)
            sock.connect(path)
            sock.sendall((json.dumps(payload) + "\n").encode())
            data = b""
            while not data.endswith(b"\n"):
                chunk = sock.recv(65536)
                if not chunk:
                    break
                data += chunk
        return json.loads(data.decode() or "{}")
    except Exception as exc:
        return {"success": False, "error": str(exc)}


def _fcitx_environment():
    """Reuse the graphical Fcitx5 session bus owned by the UI launcher."""
    environment = os.environ.copy()
    try:
        for entry in os.listdir("/proc"):
            if not entry.isdigit():
                continue
            try:
                with open(f"/proc/{entry}/comm", encoding="utf-8") as handle:
                    if handle.read().strip() != "fcitx5":
                        continue
                with open(f"/proc/{entry}/environ", "rb") as handle:
                    values = handle.read().split(b"\0")
                for value in values:
                    if b"=" not in value:
                        continue
                    name, content = value.split(b"=", 1)
                    if name.decode(errors="ignore") in {
                        "DBUS_SESSION_BUS_ADDRESS", "DISPLAY", "WAYLAND_DISPLAY",
                        "XDG_RUNTIME_DIR", "XDG_SESSION_TYPE",
                    }:
                        environment[name.decode()] = content.decode(errors="ignore")
                break
            except (OSError, UnicodeError):
                continue
    except OSError:
        pass
    return environment


def _write_input_method(mode):
    os.makedirs(os.path.dirname(INPUT_METHOD_PATH), exist_ok=True)
    fd, temp_path = tempfile.mkstemp(prefix="input-method.", dir=os.path.dirname(INPUT_METHOD_PATH))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump({"success": True, "mode": mode}, handle)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, INPUT_METHOD_PATH)
    finally:
        try:
            os.remove(temp_path)
        except OSError:
            pass


def input_method_status():
    saved = read_json(INPUT_METHOD_PATH, {"mode": "latin"})
    mode = saved.get("mode") if saved.get("mode") in {"latin", "pinyin"} else "latin"
    return {"success": True, "mode": mode, "label": "中" if mode == "pinyin" else "ABC"}


def set_input_method(payload):
    requested = str(payload.get("mode", "toggle")).lower()
    current = input_method_status().get("mode", "latin")
    mode = ("latin" if current == "pinyin" else "pinyin") if requested == "toggle" else requested
    if mode not in {"latin", "pinyin"}:
        return {"success": False, "error": "Unsupported input method"}
    command = "pinyin" if mode == "pinyin" else "keyboard-us"
    try:
        result = subprocess.run(
            ["fcitx5-remote", "-s", command],
            env=_fcitx_environment(), capture_output=True, text=True, timeout=4,
        )
        if result.returncode != 0:
            return {"success": False, "error": result.stderr.strip() or "Fcitx5 输入法切换失败"}
    except (OSError, subprocess.SubprocessError) as exc:
        return {"success": False, "error": str(exc)}
    _write_input_method(mode)
    return input_method_status()


def _clipboard_text():
    """Return the phone Flow clipboard first, then this device's last copy."""
    flow = read_json("/run/yunsh/flow-clipboard.json", {})
    flow_text = str(flow.get("text", ""))[:20000]
    if flow_text:
        return flow_text
    local = read_json(LOCAL_CLIPBOARD_PATH, {})
    return str(local.get("text", ""))[:20000]


def save_local_clipboard(payload):
    text = str(payload.get("text", ""))
    if len(text) > 20000 or "\x00" in text:
        return {"success": False, "error": "Clipboard text is invalid"}
    os.makedirs(os.path.dirname(LOCAL_CLIPBOARD_PATH), exist_ok=True)
    fd, temporary = tempfile.mkstemp(
        prefix="local-clipboard.", dir=os.path.dirname(LOCAL_CLIPBOARD_PATH)
    )
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump({"text": text, "updatedAt": time.time()}, handle, ensure_ascii=False)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, LOCAL_CLIPBOARD_PATH)
    finally:
        try:
            os.unlink(temporary)
        except OSError:
            pass
    return {"success": True, "text": text}


def inject_input_key(payload):
    key = str(payload.get("key", ""))
    if not key or len(key) > 16 or any(char in key for char in "\r\n\x00"):
        return {"success": False, "error": "Invalid key"}
    try:
        result = subprocess.run(
            ["/usr/bin/yunsh-keyinject", key],
            capture_output=True, text=True, timeout=2,
        )
        if result.returncode != 0:
            return {"success": False, "error": result.stderr.strip() or "Key injection failed"}
        return {"success": True}
    except (OSError, subprocess.SubprocessError) as exc:
        return {"success": False, "error": str(exc)}


def connect_wifi(payload):
    ssid = payload.get("ssid", "")
    password = payload.get("password", "")
    if not ssid:
        return {"success": False, "error": "SSID is required"}
    result = socket_command("network", {
        "command": "connect", "ssid": ssid, "password": password,
    })
    if result.get("success"):
        return result
    return {
        "success": False,
        "error": result.get("error") or result.get("message") or "Wi-Fi connection failed",
    }


def configure_activation(payload):
    """Persist first-run preferences without allowing arbitrary commands."""
    display_name = str(payload.get("displayName", "YUNSH User")).strip()
    password = str(payload.get("password", ""))
    boot_password = str(payload.get("bootPassword", ""))
    language = str(payload.get("language", "简体中文"))
    keyboard = str(payload.get("keyboard", "拼音"))
    allowed_languages = {"简体中文", "繁體中文", "English", "日本語", "한국어"}
    if language not in allowed_languages:
        return {"success": False, "error": "Unsupported language"}
    if (
        not display_name
        or len(display_name) > 48
        or any(character in display_name for character in "\r\n\x00")
    ):
        return {"success": False, "error": "Display name must contain 1–48 valid characters"}
    if password and (
        len(password) < 4
        or len(password) > 128
        or "\n" in password
        or "\r" in password
        or "\x00" in password
    ):
        return {"success": False, "error": "Password must contain 4–128 valid characters"}
    if boot_password and (
        len(boot_password) < 4
        or len(boot_password) > 128
        or "\n" in boot_password
        or "\r" in boot_password
        or "\x00" in boot_password
    ):
        return {"success": False, "error": "Boot password must contain 4–128 valid characters"}
    try:
        # The Linux credential is deliberately separate from the YUNSH account
        # credential.  It is used only for the local unlock gate.
        if boot_password:
            changed = subprocess.run(
                ["chpasswd"], input=f"yunsh:{boot_password}\n",
                capture_output=True, text=True, timeout=10,
            )
            if changed.returncode != 0:
                return {"success": False, "error": changed.stderr.strip() or "无法设置本机密码"}
        os.makedirs(YUNSH_CONFIG_DIR, exist_ok=True)
        fd, temp_path = tempfile.mkstemp(prefix="language.", dir=YUNSH_CONFIG_DIR)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(f"language={language}\nkeyboard={keyboard}\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, os.path.join(YUNSH_CONFIG_DIR, "language.conf"))
        salt = secrets.token_bytes(16)
        password_hash = (
            hashlib.pbkdf2_hmac(
                "sha256", password.encode("utf-8"), salt, 310000
            ).hex()
            if password else ""
        )
        account = {
            "schema": 1,
            "type": "local",
            "displayName": display_name,
            "passwordProtected": bool(password),
            "passwordKdf": "pbkdf2-sha256-310000" if password else "",
            "passwordSalt": salt.hex() if password else "",
            "passwordHash": password_hash,
            "createdAt": datetime.now(timezone.utc).isoformat(),
        }
        account_path = os.path.join(YUNSH_CONFIG_DIR, "account.json")
        fd, temp_path = tempfile.mkstemp(prefix="account.", dir=YUNSH_CONFIG_DIR)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(account, handle, ensure_ascii=False)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp_path, 0o600)
        os.replace(temp_path, account_path)
        return {"success": True}
    except Exception as exc:
        return {"success": False, "error": str(exc)}


def verify_linux_password(username, password):
    """Verify a local Linux password through PAM without exposing credentials."""
    if not password:
        return False
    try:
        import PAM
        def conversation(_auth, queries, _data):
            responses = []
            for _prompt, style in queries:
                if style in (PAM.PAM_PROMPT_ECHO_ON, PAM.PAM_PROMPT_ECHO_OFF):
                    responses.append((password, 0))
                else:
                    responses.append(("", 0))
            return responses
        checker = PAM.pam()
        checker.start("login")
        checker.set_item(PAM.PAM_USER, username)
        checker.set_item(PAM.PAM_CONV, conversation)
        checker.authenticate()
        checker.acct_mgmt()
        return True
    except Exception:
        return False


def change_boot_password(payload):
    """Change only the Linux yunsh password used for local unlock."""
    current_password = str(payload.get("currentPassword", ""))
    new_password = str(payload.get("newPassword", ""))
    if (
        len(current_password) > 128
        or len(new_password) < 4
        or len(new_password) > 128
        or any(character in current_password + new_password for character in "\r\n\x00")
    ):
        return {"success": False, "error": "密码必须包含 4–128 个有效字符"}

    if not verify_linux_password("yunsh", current_password):
        return {"success": False, "error": "当前开机密码不正确"}
    try:
        changed = subprocess.run(
            ["chpasswd", "-c", "SHA512"],
            input=f"yunsh:{new_password}\n",
            capture_output=True,
            text=True,
            timeout=10,
        )
        if changed.returncode != 0:
            return {
                "success": False,
                "error": changed.stderr.strip() or "无法修改 Linux 开机密码",
            }
        return {"success": True, "linuxUser": "yunsh", "yunshAccountChanged": False}
    except Exception as exc:
        return {"success": False, "error": str(exc)}


def verify_boot_password(payload):
    """Authenticate the local unlock gate without exposing any credential."""
    password = str(payload.get("password", ""))
    if len(password) > 128 or any(character in password for character in "\r\n\x00"):
        return {"success": False, "error": "密码格式不正确"}
    if not verify_linux_password("yunsh", password):
        return {"success": False, "error": "本机密码不正确"}
    return {"success": True}


