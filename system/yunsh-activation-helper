    return {
        "success": True,
        "live": time.time() - last_frame < 3,
        "lastFrame": last_frame,
        "width": status.get("width"),
        "height": status.get("height"),
    }


def local_certificate_fingerprint():
    try:
        with open(SPACE_TRANSFER_CERT, "r", encoding="utf-8") as handle:
            der = ssl.PEM_cert_to_DER_cert(handle.read())
        return hashlib.sha256(der).hexdigest()
    except (OSError, ValueError):
        return ""


def parse_txt_fields(fields):
    result = {}
    for field in fields:
        value = str(field).strip().strip('"')
        if "=" in value:
            key, item = value.split("=", 1)
            result[key] = item
    return result


def discover_space_peers():
    try:
        process = subprocess.run(
            ["avahi-browse", "-rtp", "_yunsh-space._tcp"],
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {"success": False, "error": str(exc), "peers": []}
    own_fingerprint = local_certificate_fingerprint()
    peers = {}
    for row in csv.reader(process.stdout.splitlines(), delimiter=";"):
        if len(row) < 9 or row[0] != "=":
            continue
        try:
            address = row[7]
            address_object = ipaddress.ip_address(address)
            port = int(row[8])
        except (ValueError, TypeError):
            continue
        if not (address_object.is_private or address_object.is_link_local):
            continue
        txt = parse_txt_fields(row[9:])
        fingerprint = txt.get("fp", "").lower()
        if (
            not re.fullmatch(r"[a-f0-9]{64}", fingerprint)
            or txt.get("transport") != "tls"
            or fingerprint == own_fingerprint
            or not 1 <= port <= 65535
        ):
            continue
        device_id = txt.get("id", fingerprint[:16])
        peers[device_id] = {
            "id": device_id,
            "name": row[3] or "Nearby YUNSH",
            "address": address,
            "port": port,
            "fingerprint": fingerprint,
            "version": txt.get("version", ""),
        }
    return {"success": True, "peers": list(peers.values())[:24]}


def send_space_capsule(payload):
    loaded = load_space_capsule({"filename": payload.get("filename")})
    if not loaded.get("success"):
        return loaded
    address = str(payload.get("address", ""))
    fingerprint = str(payload.get("fingerprint", "")).lower()
    try:
        address_object = ipaddress.ip_address(address)
        port = int(payload.get("port"))
    except (ValueError, TypeError):
        return {"success": False, "error": "Invalid nearby device"}
    if not (address_object.is_private or address_object.is_link_local):
        return {"success": False, "error": "Transfers are limited to the local network"}
    if not 1 <= port <= 65535 or not re.fullmatch(r"[a-f0-9]{64}", fingerprint):
        return {"success": False, "error": "Invalid transfer identity"}

    context = ssl.create_default_context()
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    connection = http.client.HTTPSConnection(address, port, context=context, timeout=8)
    try:
        connection.connect()
        certificate = connection.sock.getpeercert(binary_form=True)
        actual = hashlib.sha256(certificate).hexdigest()
        if not certificate or actual != fingerprint:
            return {"success": False, "error": "Nearby device identity changed"}
        body = json.dumps(
            {
                "senderName": socket.gethostname(),
                "capsule": loaded["capsule"],
            },
            ensure_ascii=False,
        ).encode("utf-8")
        connection.request(
            "POST",
            "/v1/offers",
            body=body,
            headers={
                "Content-Type": "application/json",
                "Content-Length": str(len(body)),
            },
        )
        response = connection.getresponse()
        data = json.loads(response.read(1024 * 1024).decode("utf-8") or "{}")
        if response.status != 202 or not data.get("success"):
            return {
                "success": False,
                "error": data.get("error", f"Receiver returned {response.status}"),
            }
        return {
            "success": True,
            "offerId": data.get("offerId"),
            "status": data.get("status", "pending"),
        }
    except (OSError, ssl.SSLError, ValueError, http.client.HTTPException) as exc:
        return {"success": False, "error": str(exc)}
    finally:
        connection.close()


def list_space_inbox():
    offers = []
    try:
        os.makedirs(SPACE_INBOX_DIR, exist_ok=True)
        filenames = os.listdir(SPACE_INBOX_DIR)
    except OSError as exc:
        return {"success": False, "error": str(exc), "offers": []}
    for filename in filenames:
        if not re.fullmatch(r"[a-f0-9]{32}\.json", filename):
            continue
        record = read_json(os.path.join(SPACE_INBOX_DIR, filename), {})
        capsule = record.get("capsule", {})
        if record.get("status") != "pending" or not isinstance(capsule, dict):
            continue
        offers.append(
            {
                "offerId": record.get("offerId", filename[:-5]),
                "senderName": str(record.get("senderName", "Nearby YUNSH"))[:64],
                "receivedAt": str(record.get("receivedAt", "")),
                "name": safe_capsule_name(capsule.get("name")),
                "windowCount": min(
                    len(capsule.get("windows", []))
                    if isinstance(capsule.get("windows"), list)
                    else 0,
                    20,
                ),
            }
        )
    offers.sort(key=lambda item: item["receivedAt"], reverse=True)
    return {"success": True, "offers": offers[:50]}


def respond_space_offer(payload):
    offer_id = str(payload.get("offerId", ""))
    action = str(payload.get("action", ""))
    if not re.fullmatch(r"[a-f0-9]{32}", offer_id) or action not in {"accept", "reject"}:
        return {"success": False, "error": "Invalid offer response"}
    record_path = os.path.join(SPACE_INBOX_DIR, offer_id + ".json")
    record = read_json(record_path, {})
    if record.get("offerId") != offer_id or record.get("status") != "pending":
        return {"success": False, "error": "Offer is no longer pending"}
    if action == "reject":
        record["status"] = "rejected"
        record["respondedAt"] = datetime.now(timezone.utc).isoformat()
        try:
            atomic_write_json(record_path, record)
            return {"success": True, "status": "rejected"}
        except OSError as exc:
            return {"success": False, "error": str(exc)}

    capsule = record.get("capsule")
    if not isinstance(capsule, dict):
        return {"success": False, "error": "Invalid received SpaceCapsule"}
    # Reuse the same schema and app allow-list validator used for local restores.
    temporary_name = f"YUNSH-Drop-{datetime.now().strftime('%Y%m%d-%H%M%S-%f')}{SPACE_CAPSULE_EXTENSION}"
    destination = os.path.join(SPACE_CAPSULE_DIR, temporary_name)
    try:
        atomic_write_json(destination, capsule)
        validated = load_space_capsule({"filename": temporary_name})
        if not validated.get("success"):
            os.unlink(destination)
            return validated
        os.chmod(destination, 0o644)
        record["status"] = "accepted"
        record["respondedAt"] = datetime.now(timezone.utc).isoformat()
        record["filename"] = temporary_name
        atomic_write_json(record_path, record)
        return {
            "success": True,
            "status": "accepted",
            "filename": temporary_name,
            "capsule": validated["capsule"],
        }
    except OSError as exc:
        return {"success": False, "error": str(exc)}


def update_response(action, payload):
    command = {
        "/api/update-status": "get_status",
        "/api/update-check": "check",
        "/api/update-download": "start_download",
        "/api/update-cancel": "cancel",
    }.get(action)
    if action == "/api/update-config":
        requested = payload.get("action", "")
        if requested == "set_auto_update" or "autoUpdate" in payload:
            command = "set_auto_update"
            payload["auto_update"] = payload.get("value", payload.get("autoUpdate", True))
        elif requested == "set_wifi_only" or "wifiOnly" in payload:
            command = "set_wifi_only"
            payload["wifi_only"] = payload.get("value", payload.get("wifiOnly", True))
        elif requested == "set_channel":
            command = "set_channel"
        elif requested == "set_allow_major_update":
            command = "set_allow_major_update"
        else:
            command = "get_config"
    result = socket_command("update", {"action": command or "get_status", **payload})
    return {
        **result,
        "currentVersion": result.get("current_version", ""),
        "latestVersion": result.get("latest_version", ""),
        "updateAvailable": result.get("update_available", False),
        "autoUpdate": result.get("auto_update", True),
        "wifiOnly": result.get("wifi_only", True),
        "lastCheckTime": result.get("last_check_ts", ""),
        "changelog": result.get("changelog", ""),
        "state": result.get("state", "idle"),
        "progress": result.get("progress_pct", 0),
        "error": result.get("error"),
        "rebootRequired": result.get("reboot_required", False),
    }


class Handler(BaseHTTPRequestHandler):
    def _payload(self):
        length = int(self.headers.get("Content-Length", "0"))
        if length < 0 or length > 1_048_576:
            return {}
        try:
            return json.loads(self.rfile.read(length) or b"{}")
        except ValueError:
            return {}

    def _send(self, result, status=200):
        body = json.dumps(result, ensure_ascii=False).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.startswith("/api/update-"):
            self._send(update_response(self.path, {}))
        elif self.path == "/api/network-status":
            # Query the daemon directly so activation does not display a stale
            # Ethernet/Wi-Fi state from the periodic status file.
            self._send(socket_command("network", {"command": "status"}))
        elif self.path == "/api/bluetooth-status":
            self._send(socket_command("bluetooth", {"command": "status"}))
        elif self.path == "/api/glasses-status":
            self._send(read_json(GLASSES_STATUS_PATH, {"connected": False}))
        elif self.path == "/api/power-status":
            self._send(read_json("/tmp/yunsh-power-status.json", {"available": False}))
        elif self.path == "/api/spatial-preferences":
            self._send(load_spatial_preferences())
        elif self.path == "/api/comfort-dna":
            self._send(load_comfort_dna())
        elif self.path == "/api/space-capsules":
            self._send(list_space_capsules())
        elif self.path == "/api/space-peers":
            self._send(discover_space_peers())
        elif self.path == "/api/space-inbox":
            self._send(list_space_inbox())
        elif self.path == "/api/link-status":
            self._send(get_link_status())
        elif self.path == "/api/link-pairing":
            self._send(get_link_pairing_code())
        elif self.path == "/api/ui-command":
            self._send(get_ui_command())
        elif self.path == "/api/clipboard":
            self._send({"success": True, "text": _clipboard_text()})
        elif self.path == "/api/boot-lock":
            self._send({"success": True, "required": os.path.exists(BOOT_LOCK_PATH)})
        elif self.path == "/api/input-method":
            self._send(input_method_status())
        elif self.path == "/api/screen-relay-status":
            self._send(get_screen_relay_status())
        else:
            self._send({"success": True, "message": "YUNSH local API"})

    def do_POST(self):
        payload = self._payload()
        if self.path.startswith("/api/update-"):
            result = update_response(self.path, payload)
        elif self.path == "/api/network":
            result = connect_wifi(payload) if payload.get("command") == "connect" else socket_command("network", payload)
        elif self.path == "/api/bluetooth":
            result = socket_command("bluetooth", payload)
        elif self.path == "/api/factory-reset":
            try:
                subprocess.Popen(
                    ["/usr/bin/yunsh-factory-reset"],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
                result = {"success": True, "message": "factory reset started"}
            except OSError as exc:
                result = {"success": False, "error": str(exc)}
        elif self.path == "/api/glasses":
            if payload.get("action") == "set_brightness":
                result = set_glasses_brightness(payload)
            else:
                result = {"success": False, "error": "Unsupported glasses action"}
        elif self.path == "/api/audio":
            if payload.get("action") == "set_volume":
                result = set_volume(payload)
            else:
                result = {"success": False, "error": "Unsupported audio action"}
        elif self.path == "/api/spatial-preferences":
            result = save_spatial_preferences(payload)
        elif self.path == "/api/comfort-dna":
            result = save_comfort_dna(payload)
        elif self.path == "/api/space-capsules":
            action = payload.get("action")
            if action == "export":
                result = export_space_capsule(payload)
            elif action == "load":
                result = load_space_capsule(payload)
            else:
                result = {"success": False, "error": "Unsupported SpaceCapsule action"}
        elif self.path == "/api/space-transfer":
            action = payload.get("action")
            if action == "send":
                result = send_space_capsule(payload)
            elif action in {"accept", "reject"}:
                result = respond_space_offer(payload)
            else:
                result = {"success": False, "error": "Unsupported transfer action"}
        elif self.path == "/api/link-pairing":
            result = create_link_pairing_code()
        elif self.path == "/api/boot-password":
            result = change_boot_password(payload)
        elif self.path == "/api/lock-state":
            result = set_lock_state(payload)
        elif self.path == "/api/boot-lock":
            result = set_boot_lock(payload)
        elif self.path == "/api/input-method":
            result = set_input_method(payload)
        elif self.path == "/api/clipboard":
            result = save_local_clipboard(payload)
        elif self.path == "/api/input-key":
            result = inject_input_key(payload)
        elif self.path == "/api/verify-boot-password":
            result = verify_boot_password(payload)
        else:
            action = payload.get("action")
            if action == "connect_wifi":
                result = connect_wifi(payload)
            elif action == "configure_activation":
                result = configure_activation(payload)
            else:
                result = {"success": action == "ping"}
        self._send(result)

    def log_message(self, _format, *_args):
        return


