def set_volume(payload):
    try:
        value = max(0, min(100, int(payload.get("value"))))
    except (TypeError, ValueError) as exc:
        return {"success": False, "error": str(exc)}
    commands = (
        ["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{value}%"],
        ["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{value}%"],
        ["amixer", "sset", "Master", f"{value}%"],
    )
    errors = []
    for command in commands:
        try:
            result = subprocess.run(
                command, capture_output=True, text=True, timeout=10
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            errors.append(str(exc))
            continue
        if result.returncode == 0:
            return {"success": True, "volume": value}
        errors.append(result.stderr.strip() or result.stdout.strip())
    return {
        "success": False,
        "error": next((error for error in errors if error), "No audio output is available"),
    }


def read_json(path, default=None):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return default or {}


def set_lock_state(payload):
    """Publish graphical lock state for local Agent/runtime gating."""
    locked = bool(payload.get("locked"))
    if locked:
        os.makedirs(os.path.dirname(LOCK_STATE_PATH), exist_ok=True)
        temporary = f"{LOCK_STATE_PATH}.tmp.{os.getpid()}"
        with open(temporary, "w", encoding="utf-8") as handle:
            json.dump({"locked": True, "updatedAt": time.time()}, handle)
        os.replace(temporary, LOCK_STATE_PATH)
    else:
        try:
            os.unlink(LOCK_STATE_PATH)
        except FileNotFoundError:
            pass
    return {"success": True, "locked": locked}


def set_boot_lock(payload):
    """Require a fresh local unlock after the next normal boot."""
    required = bool(payload.get("required"))
    try:
        if required:
            os.makedirs(os.path.dirname(BOOT_LOCK_PATH), exist_ok=True)
            temporary = f"{BOOT_LOCK_PATH}.tmp.{os.getpid()}"
            with open(temporary, "w", encoding="utf-8") as handle:
                handle.write("required\n")
            os.chmod(temporary, 0o600)
            os.replace(temporary, BOOT_LOCK_PATH)
        else:
            os.unlink(BOOT_LOCK_PATH)
    except FileNotFoundError:
        pass
    except OSError as exc:
        return {"success": False, "error": str(exc)}
    return {"success": True, "required": required}


def sanitize_spatial_preferences(payload):
    """Accept only known display preferences and clamp numeric calibration."""
    result = dict(SPATIAL_DEFAULTS)
    for key, default in SPATIAL_DEFAULTS.items():
        value = payload.get(key, default)
        if isinstance(default, bool):
            if isinstance(value, bool):
                result[key] = value
            continue
        try:
            number = float(value)
        except (TypeError, ValueError):
            continue
        if not math.isfinite(number):
            continue
        minimum, maximum = SPATIAL_RANGES[key]
        result[key] = max(minimum, min(maximum, number))
    return result


def load_spatial_preferences():
    stored = read_json(SPATIAL_PREFERENCES_PATH, {})
    result = sanitize_spatial_preferences(stored)
    result["success"] = True
    return result


def save_spatial_preferences(payload):
    preferences = sanitize_spatial_preferences(payload)
    try:
        os.makedirs(YUNSH_CONFIG_DIR, exist_ok=True)
        fd, temp_path = tempfile.mkstemp(
            prefix="spatial-display.", dir=YUNSH_CONFIG_DIR
        )
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(
                preferences,
                handle,
                ensure_ascii=False,
                sort_keys=True,
                indent=2,
            )
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, SPATIAL_PREFERENCES_PATH)
        return {"success": True, **preferences}
    except OSError as exc:
        return {"success": False, "error": str(exc)}


def atomic_write_json(path, payload):
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    fd, temp_path = tempfile.mkstemp(prefix=os.path.basename(path) + ".", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, ensure_ascii=False, sort_keys=True, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, path)
    except Exception:
        try:
            os.unlink(temp_path)
        except OSError:
            pass
        raise


def load_comfort_dna():
    stored = read_json(COMFORT_DNA_PATH, {})
    profile = stored.get("profile", "balanced")
    if profile not in COMFORT_PROFILES:
        profile = "balanced"
    return {
        "success": True,
        "configured": stored.get("configured") is True,
        "skipped": stored.get("skipped") is True,
        "profile": profile,
        **COMFORT_PROFILES[profile],
    }


def save_comfort_dna(payload):
    action = str(payload.get("action", "apply"))
    if action == "skip":
        record = {
            "configured": False,
            "skipped": True,
            "profile": "balanced",
            "updatedAt": datetime.now(timezone.utc).isoformat(),
        }
        try:
            atomic_write_json(COMFORT_DNA_PATH, record)
            return {"success": True, **record}
        except OSError as exc:
            return {"success": False, "error": str(exc)}

    profile = str(payload.get("profile", "balanced"))
    if profile not in COMFORT_PROFILES:
        return {"success": False, "error": "Unsupported comfort profile"}

    profile_values = COMFORT_PROFILES[profile]
    spatial = load_spatial_preferences()
    spatial.pop("success", None)
    spatial.update(
        {
            "trackingSmoothing": profile_values["trackingSmoothing"],
            "fieldOfView": profile_values["fieldOfView"],
            "reduceMotion": profile_values["reduceMotion"],
        }
    )
    spatial_result = save_spatial_preferences(spatial)
    if not spatial_result.get("success"):
        return spatial_result

    record = {
        "configured": True,
        "skipped": False,
        "profile": profile,
        "updatedAt": datetime.now(timezone.utc).isoformat(),
    }
    try:
        atomic_write_json(COMFORT_DNA_PATH, record)
        return {"success": True, **record, **profile_values}
    except OSError as exc:
        return {"success": False, "error": str(exc)}


def clamp_number(value, minimum, maximum, default):
    try:
        number = float(value)
    except (TypeError, ValueError):
        return default
    if not math.isfinite(number):
        return default
    return max(minimum, min(maximum, number))


def sanitize_capsule_window(item):
    if not isinstance(item, dict):
        return None
    app_id = str(item.get("appId", ""))
    if app_id not in CAPSULE_ALLOWED_APPS:
        return None
    placement = str(item.get("spatialPlacement", "front"))
    if placement not in {"front", "left", "right", "far"}:
        placement = "front"
    pin_mode = str(item.get("pinMode", "pinned"))
    if pin_mode not in {"pinned", "following"}:
        pin_mode = "pinned"
    result = {
        "appId": app_id,
        "x": clamp_number(item.get("x"), -1920, 3840, 80),
        "y": clamp_number(item.get("y"), -1080, 2160, 60),
        "width": clamp_number(item.get("width"), 320, 1600, 880),
        "height": clamp_number(item.get("height"), 240, 1000, 640),
        "visible": item.get("visible") is True,
        "minimized": item.get("minimized") is True,
        "spatialPlacement": placement,
        "pinMode": pin_mode,
        "order": int(clamp_number(item.get("order"), 0, 1000, 0)),
    }
    app_state = item.get("state")
    if app_id == "browser" and isinstance(app_state, dict):
        url = str(app_state.get("url", ""))[:2048]
        if url.startswith(("https://", "http://")):
            result["state"] = {"url": url}
    return result


def safe_capsule_name(value):
    name = re.sub(r"[\x00-\x1f/\\\\]+", " ", str(value or "")).strip()
    name = re.sub(r"\s+", " ", name)
    return name[:48] or "我的空间"


def capsule_path_from_filename(filename):
    candidate = os.path.basename(str(filename or ""))
    if candidate != filename or not candidate.endswith(SPACE_CAPSULE_EXTENSION):
        return None
    base = os.path.realpath(SPACE_CAPSULE_DIR)
    path = os.path.realpath(os.path.join(base, candidate))
    if not path.startswith(base + os.sep):
        return None
    return path


def export_space_capsule(payload):
    windows = []
    raw_windows = payload.get("windows", [])
    if not isinstance(raw_windows, list):
        return {"success": False, "error": "Workspace windows must be a list"}
    for item in raw_windows[:20]:
        sanitized = sanitize_capsule_window(item)
        if sanitized:
            windows.append(sanitized)
    if not windows:
        return {"success": False, "error": "Workspace has no restorable windows"}

    name = safe_capsule_name(payload.get("name"))
    active_app = str(payload.get("activeAppId", ""))
    if active_app not in CAPSULE_ALLOWED_APPS:
        active_app = ""
    created_at = datetime.now(timezone.utc)
    capsule = {
        "format": "yunsh-space-capsule",
        "schemaVersion": SPACE_CAPSULE_SCHEMA,
        "product": "YUNSH OS",
        "name": name,
        "createdAt": created_at.isoformat(),
        "activeAppId": active_app,
        "windows": windows,
    }
    filename = (
        "YUNSH-SpaceCapsule-"
        + created_at.strftime("%Y%m%d-%H%M%S-%f")
        + SPACE_CAPSULE_EXTENSION
    )
    path = os.path.join(SPACE_CAPSULE_DIR, filename)
    try:
        atomic_write_json(path, capsule)
        os.chmod(path, 0o644)
        try:
            home_owner = os.stat(YUNSH_HOME_DIR)
            os.chown(path, home_owner.st_uid, home_owner.st_gid)
        except OSError:
            pass
        return {
            "success": True,
            "filename": filename,
            "path": path,
            "name": name,
            "createdAt": capsule["createdAt"],
            "windowCount": len(windows),
        }
    except OSError as exc:
        return {"success": False, "error": str(exc)}


def load_space_capsule(payload):
    path = capsule_path_from_filename(payload.get("filename"))
    if not path:
        return {"success": False, "error": "Invalid capsule filename"}
    try:
        if os.path.getsize(path) > 1024 * 1024:
            return {"success": False, "error": "SpaceCapsule is too large"}
    except OSError:
        return {"success": False, "error": "SpaceCapsule was not found"}
    stored = read_json(path, None)
    if not isinstance(stored, dict) or stored.get("format") != "yunsh-space-capsule":
        return {"success": False, "error": "Invalid SpaceCapsule format"}
    if stored.get("schemaVersion") != SPACE_CAPSULE_SCHEMA:
        return {"success": False, "error": "Unsupported SpaceCapsule version"}
    windows = []
    raw_windows = stored.get("windows", [])
    if not isinstance(raw_windows, list):
        return {"success": False, "error": "SpaceCapsule windows are invalid"}
    for item in raw_windows[:20]:
        sanitized = sanitize_capsule_window(item)
        if sanitized:
            windows.append(sanitized)
    if not windows:
        return {"success": False, "error": "SpaceCapsule contains no supported windows"}
    active_app = str(stored.get("activeAppId", ""))
    if active_app not in CAPSULE_ALLOWED_APPS:
        active_app = ""
    return {
        "success": True,
        "capsule": {
            "format": "yunsh-space-capsule",
            "schemaVersion": SPACE_CAPSULE_SCHEMA,
            "name": safe_capsule_name(stored.get("name")),
            "createdAt": str(stored.get("createdAt", "")),
            "activeAppId": active_app,
            "windows": windows,
        },
    }


def list_space_capsules():
    capsules = []
    try:
        os.makedirs(SPACE_CAPSULE_DIR, exist_ok=True)
        for filename in os.listdir(SPACE_CAPSULE_DIR):
            if not filename.endswith(SPACE_CAPSULE_EXTENSION):
                continue
            path = capsule_path_from_filename(filename)
            try:
                oversized = not path or os.path.getsize(path) > 1024 * 1024
            except OSError:
                oversized = True
            if oversized:
                continue
            stored = read_json(path, None)
            if not isinstance(stored, dict) or stored.get("format") != "yunsh-space-capsule":
                continue
            capsules.append(
                {
                    "filename": filename,
                    "name": safe_capsule_name(stored.get("name")),
                    "createdAt": str(stored.get("createdAt", "")),
                    "windowCount": min(
                        len(stored.get("windows", []))
                        if isinstance(stored.get("windows"), list)
                        else 0,
                        20,
                    ),
                    "path": path,
                }
            )
    except OSError as exc:
        return {"success": False, "error": str(exc), "capsules": []}
    capsules.sort(key=lambda item: item["createdAt"], reverse=True)
    return {"success": True, "capsules": capsules[:50]}


def get_link_status():
    status = read_json(LINK_STATUS_PATH, {})
    try:
        last_activity = float(status.get("lastActivity", 0))
    except (TypeError, ValueError):
        last_activity = 0
    connected = (
        bool(status.get("connected"))
        and bool(status.get("authenticated"))
        and time.time() - last_activity < 15
    )
    return {
        "success": True,
        "connected": connected,
        "authenticated": bool(status.get("authenticated")),
        "mode": status.get("mode", "yunsh-os"),
        "device": status.get("device", ""),
        "lastActivity": last_activity,
    }


def create_link_pairing_code():
    alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
    code = "".join(secrets.choice(alphabet) for _ in range(6))
    record = {
        "code": code,
        "createdAt": time.time(),
        "expiresAt": time.time() + 600,
        "used": False,
    }
    try:
        atomic_write_json(LINK_PAIRING_PATH, record)
        os.chmod(LINK_PAIRING_PATH, 0o600)
        return {
            "success": True,
            "code": code,
            "expiresAt": record["expiresAt"],
        }
    except OSError as exc:
        return {"success": False, "error": str(exc)}


def get_link_pairing_code():
    record = read_json(LINK_PAIRING_PATH, {})
    try:
        valid = (
            re.fullmatch(r"[A-HJ-NP-Z2-9]{6}", str(record.get("code", "")).upper()) is not None
            and record.get("used") is not True
            and float(record.get("expiresAt", 0)) > time.time()
        )
    except (TypeError, ValueError):
        valid = False
    if not valid:
        return create_link_pairing_code()
    return {
        "success": True,
        "code": record["code"],
        "expiresAt": record["expiresAt"],
    }


def get_ui_command():
    command = read_json(UI_COMMAND_PATH, {})
    if command.get("action") not in {"recenter", "open_world", "open_app"}:
        return {"success": True}
    if command.get("action") == "open_app":
        app_id = str(command.get("appId", ""))
        if app_id not in CAPSULE_ALLOWED_APPS:
            return {"success": True}
    return {"success": True, **command}


def get_screen_relay_status():
    status = read_json(SCREEN_RELAY_STATUS_PATH, {})
    try:
        last_frame = float(status.get("lastFrame", 0))
    except (TypeError, ValueError):
