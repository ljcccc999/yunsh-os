#!/bin/bash
# Capture the running YUNSH compositor or framebuffer.

SCREENSHOTS_DIR="${YUNSH_SCREENSHOT_DIR:-/home/yunsh/Pictures/Screenshots}"
mkdir -p "${SCREENSHOTS_DIR}" 2>/dev/null || {
    echo "Cannot create screenshot directory: ${SCREENSHOTS_DIR}" >&2
    exit 1
}

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/yunsh-runtime}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

TIMESTAMP="$(date +%Y-%m-%d_%H-%M-%S)"
OUTPUT_FILE="${SCREENSHOTS_DIR}/Screenshot_${TIMESTAMP}.png"
WORK_DIR="$(mktemp -d /tmp/yunsh-screenshot.XXXXXX)"
trap 'rm -rf "${WORK_DIR}"' EXIT

valid_png() {
    [ -s "$1" ] || return 1
    python3 - "$1" <<'PY' >/dev/null 2>&1
import sys
from PIL import Image
with Image.open(sys.argv[1]) as image:
    image.verify()
PY
}

capture_wayland_full() {
    if command -v grim >/dev/null 2>&1; then
        grim "${OUTPUT_FILE}" >/dev/null 2>&1 && valid_png "${OUTPUT_FILE}" && return 0
    fi

    if command -v weston-screenshooter >/dev/null 2>&1; then
        (
            cd "${WORK_DIR}" || exit 1
            if command -v timeout >/dev/null 2>&1; then
                timeout 15 weston-screenshooter >/dev/null 2>&1
            else
                weston-screenshooter >/dev/null 2>&1
            fi
        )
        local weston_file
        weston_file="$(find "${WORK_DIR}" -maxdepth 1 -type f -name '*.png' -print -quit)"
        if [ -n "${weston_file}" ]; then
            mv "${weston_file}" "${OUTPUT_FILE}"
            valid_png "${OUTPUT_FILE}" && return 0
        fi
    fi

    if command -v gnome-screenshot >/dev/null 2>&1; then
        gnome-screenshot -f "${OUTPUT_FILE}" >/dev/null 2>&1 &&
            valid_png "${OUTPUT_FILE}" && return 0
    fi
    return 1
}

fb_resolution() {
    if [ -r /sys/class/graphics/fb0/virtual_size ]; then
        tr ',' ' ' < /sys/class/graphics/fb0/virtual_size
    else
        printf '1920 1080\n'
    fi
}

capture_fbdev_full() {
    [ -c /dev/fb0 ] || return 1
    local width height
    read -r width height < <(fb_resolution)
    python3 - "${width}" "${height}" "${OUTPUT_FILE}" <<'PY' >/dev/null 2>&1
import sys
from PIL import Image
width, height, output = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
with open("/dev/fb0", "rb") as framebuffer:
    data = framebuffer.read(width * height * 4)
if len(data) != width * height * 4:
    raise RuntimeError("short framebuffer read")
image = Image.frombuffer("RGBA", (width, height), data, "raw", "BGRA", 0, 1)
image.save(output)
PY
    valid_png "${OUTPUT_FILE}"
}

capture_full() {
    capture_wayland_full || capture_fbdev_full || {
        rm -f "${OUTPUT_FILE}"
        echo "No supported compositor screenshot protocol or readable framebuffer is available." >&2
        return 1
    }
}

capture_region() {
    local x="$1" y="$2" width="$3" height="$4"
    if command -v grim >/dev/null 2>&1 &&
        grim -g "${x},${y} ${width}x${height}" "${OUTPUT_FILE}" >/dev/null 2>&1 &&
        valid_png "${OUTPUT_FILE}"; then
        return 0
    fi

    capture_full || return 1
    python3 - "${OUTPUT_FILE}" "${x}" "${y}" "${width}" "${height}" <<'PY'
import os
import sys
from PIL import Image
path, x, y, width, height = sys.argv[1], *map(int, sys.argv[2:])
with Image.open(path) as image:
    left = max(0, x)
    top = max(0, y)
    right = min(image.width, left + max(1, width))
    bottom = min(image.height, top + max(1, height))
    if right <= left or bottom <= top:
        raise RuntimeError("screenshot region is outside the display")
    cropped = image.crop((left, top, right, bottom))
    temporary = path + ".crop"
    cropped.save(temporary, format="PNG")
os.replace(temporary, path)
PY
}

capture_status=0
case "${1:-full}" in
    full)
        capture_full || capture_status=$?
        ;;
    region)
        [ "$#" -eq 5 ] || {
            echo "Usage: yunsh-screenshotd region x y width height" >&2
            exit 2
        }
        capture_region "$2" "$3" "$4" "$5" || capture_status=$?
        ;;
    *)
        echo "Usage: yunsh-screenshotd [full|region x y width height]" >&2
        exit 2
        ;;
esac

[ "${capture_status}" -eq 0 ] || exit "${capture_status}"
cp "${OUTPUT_FILE}" /tmp/yunsh-clipboard.png 2>/dev/null || true
printf '%s\n' "${OUTPUT_FILE}"
