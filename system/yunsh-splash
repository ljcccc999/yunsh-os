#!/bin/bash
# YUNSH OS two-stage boot branding for framebuffer and DRM-only boots.

FB_DEV="/dev/fb0"
BOOT_DIR="/boot/firmware"
[ -d "${BOOT_DIR}" ] || BOOT_DIR="/boot"

tty_brand() {
    [ -w /dev/tty1 ] || return 0
    {
        printf '\033[2J\033[H\033[?25l'
        printf '\n\n\n\n\n\n\n\n\n\n'
        printf '\033[1;37m%*s\033[0m\n' 102 "YUNSH OS"
        printf '\033[38;2;0;212;255m%*s\033[0m\n' 104 "Starting spatial system"
    } > /dev/tty1 2>/dev/null
}

render_raw() {
    local source="$1"
    [ -c "${FB_DEV}" ] && [ -s "${source}" ] || return 1
    cat "${source}" > "${FB_DEV}" 2>/dev/null
}

# DRM/KMS commonly exposes fb0 after a short delay. If it does not, brand tty1
# instead of leaving the stock boot messages as the only visible feedback.
for _attempt in $(seq 1 30); do
    [ -c "${FB_DEV}" ] && break
    sleep 0.1
done

if ! render_raw "${BOOT_DIR}/yunsh-splash-logo.raw"; then
    tty_brand
    exit 0
fi

sleep 1.5
render_raw "${BOOT_DIR}/yunsh-splash-full.raw" || tty_brand
exit 0
