#!/bin/bash
# YUNSH OS Qt Quick launcher on a Wayland compositor.
set -u

cd /usr/share/yunsh/ui || exit 1

export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
export QTWEBENGINE_DISABLE_SANDBOX=1
export QTWEBENGINE_CHROMIUM_FLAGS="${QTWEBENGINE_CHROMIUM_FLAGS:---no-sandbox --disable-dev-shm-usage}"
export QML_XHR_ALLOW_FILE_READ=1
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/yunsh-runtime}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"

install -d -m 0700 "$XDG_RUNTIME_DIR"
install -d -o yunsh -g yunsh \
    /home/yunsh/Pictures/Screenshots /home/yunsh/Downloads \
    /home/yunsh/.cache/yunsh-browser /home/yunsh/.local/share/yunsh-browser \
    2>/dev/null || {
        install -d /home/yunsh/Pictures/Screenshots
        install -d /home/yunsh/Downloads
    }

if [ -x /usr/lib/qt6/bin/qml ]; then
    QML_RUNNER=/usr/lib/qt6/bin/qml
elif [ -x /usr/lib/qt6/bin/qmlscene ]; then
    QML_RUNNER=/usr/lib/qt6/bin/qmlscene
else
    QML_RUNNER="$(command -v qml6 || command -v qml || true)"
fi
if [ -z "$QML_RUNNER" ]; then
    echo "YUNSH: Qt QML runtime is not installed." >&2
    exit 1
fi

if [ ! -f /etc/yunsh/.packages_installed ]; then
    echo "YUNSH: First-boot setup has not completed." >&2
    exit 1
fi

/usr/bin/yunsh-disk-helper 2>/dev/null || true

# Waydroid requires a real Wayland session. Weston owns DRM/KMS and composes
# both the YUNSH shell and Android surfaces on the same display.
if ! command -v weston >/dev/null 2>&1; then
    echo "YUNSH: Weston is not installed." >&2
    exit 1
fi
if [ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
    weston --backend=drm-backend.so --shell=kiosk-shell.so \
        --socket="$WAYLAND_DISPLAY" --idle-time=0 \
        >>/var/log/yunsh-weston.log 2>&1 &
    for _ in $(seq 1 50); do
        [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && break
        sleep 0.1
    done
fi
[ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] || {
    echo "YUNSH: Wayland compositor failed to start." >&2
    exit 1
}

while true; do
    if [ -f /etc/yunsh/.activated ]; then
        "$QML_RUNNER" main.qml --activated 2>>/var/log/yunsh-ui.log
    else
        "$QML_RUNNER" main.qml --firstboot 2>>/var/log/yunsh-ui.log
        QML_EXIT=$?
        if [ "$QML_EXIT" -eq 42 ]; then
            touch /etc/yunsh/.activated
            sync
        fi
    fi
    sleep 2
done
