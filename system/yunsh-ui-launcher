#!/bin/bash
# YUNSH OS Qt Quick launcher on a Wayland compositor.
set -u

cd /usr/share/yunsh/ui || exit 1

export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
export QT_QUICK_CONTROLS_STYLE="${QT_QUICK_CONTROLS_STYLE:-Basic}"
export QTWEBENGINE_DISABLE_SANDBOX=1
export QTWEBENGINE_CHROMIUM_FLAGS="${QTWEBENGINE_CHROMIUM_FLAGS:---no-sandbox --disable-dev-shm-usage}"
export QML_XHR_ALLOW_FILE_READ=1
export QT_IM_MODULE="${QT_IM_MODULE:-fcitx}"
export GTK_IM_MODULE="${GTK_IM_MODULE:-fcitx}"
export XMODIFIERS="${XMODIFIERS:-@im=fcitx}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/yunsh-runtime}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
LOG_DIR="/var/log"
UI_LOG="${LOG_DIR}/yunsh-ui.log"
WESTON_LOG="${LOG_DIR}/yunsh-weston.log"
RECOVERY_QML="/usr/share/yunsh/ui/RecoveryScreen.qml"

install -d -m 0700 "$XDG_RUNTIME_DIR"
# Keep the graphical Fcitx5 profile deterministic: the globe key and the
# YUNSH menu both switch between the normal US layout and Pinyin.  The profile
# is created for the root-owned compositor session and for the fixed local
# account so a later desktop restart does not lose Chinese input.
for fcitx_home in /root /home/yunsh; do
    install -d -m 0700 "$fcitx_home/.config/fcitx5"
    if [ ! -f "$fcitx_home/.config/fcitx5/profile" ] ||
       ! grep -q '^Name=pinyin$' "$fcitx_home/.config/fcitx5/profile" 2>/dev/null; then
        cat > "$fcitx_home/.config/fcitx5/profile" <<'FCITX_PROFILE'
[Groups/0]
Name=Default
Default Layout=us
DefaultIM=keyboard-us

[Groups/0/Items/0]
Name=keyboard-us
Layout=us

[Groups/0/Items/1]
Name=pinyin
FCITX_PROFILE
        chmod 0600 "$fcitx_home/.config/fcitx5/profile"
    fi
done
if ! pgrep -x fcitx5 >/dev/null 2>&1; then
    # Start Fcitx inside its own persistent D-Bus session so fcitx5-remote and
    # the Qt input-method plugin talk to the same instance after a reboot.
    if command -v dbus-run-session >/dev/null 2>&1; then
        dbus-run-session -- fcitx5 --replace >>"$UI_LOG" 2>&1 &
    else
        fcitx5 -d --replace >>"$UI_LOG" 2>&1 &
    fi
    sleep 0.4
fi
install -d -o yunsh -g yunsh \
    /home/yunsh/Pictures/Screenshots /home/yunsh/Downloads \
    /home/yunsh/.cache/yunsh-browser /home/yunsh/.local/share/yunsh-browser \
    2>/dev/null || {
        install -d /home/yunsh/Pictures/Screenshots
        install -d /home/yunsh/Downloads
    }

if [ -x /usr/lib/qt6/bin/qml ]; then
    QML_RUNNER=/usr/lib/qt6/bin/qml
elif [ -x /usr/lib/qt6/bin/qmlscene ]; then
    QML_RUNNER=/usr/lib/qt6/bin/qmlscene
else
    QML_RUNNER="$(command -v qml6 || command -v qml || true)"
fi
if [ -z "$QML_RUNNER" ]; then
    echo "YUNSH: Qt QML runtime is not installed." >&2
    exit 1
fi

if [ ! -f /etc/yunsh/.packages_installed ]; then
    echo "YUNSH: First-boot setup has not completed." >&2
    exit 1
fi

# Every normal desktop start begins behind the local lock. This marker is
# intentionally independent of the Linux/SSH password and is cleared only by
# the QML unlock flow after the user has entered the local password.
if [ -f /etc/yunsh/.activated ]; then
    install -d -m 0700 /etc/yunsh
    printf 'required\n' > /etc/yunsh/boot-lock
    chmod 0600 /etc/yunsh/boot-lock
fi

/usr/bin/yunsh-disk-helper 2>/dev/null || true

# Waydroid requires a real Wayland session. Weston owns DRM/KMS and composes
# both the YUNSH shell and Android surfaces on the same display. Keep Wayland
# as the normal path; do not silently replace it with linuxfb when DRM fails.
if ! command -v weston >/dev/null 2>&1; then
    echo "YUNSH: Weston is not installed." >&2
    exit 1
fi
DISPLAY_BACKEND="wayland"
DRM_DEVICE=""
if [ -d /dev/dri ]; then
    DRM_DEVICE="$(find /dev/dri -maxdepth 1 -type c -name 'card*' -print -quit 2>/dev/null || true)"
fi

if [ -n "$DRM_DEVICE" ]; then
    # A compositor killed during startup can leave its socket behind. Do not
    # treat that dead endpoint as a valid session.
    if [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && ! pgrep -x weston >/dev/null 2>&1; then
        rm -f "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" \
            "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY.lock"
    fi
    if [ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
        # Weston versions shipped by Debian/Raspberry Pi OS do not all accept
        # --continue-without-input. Passing an unsupported option makes Weston
        # quit before it creates its Wayland socket, leaving the display black.
        # Weston GL hit drm_output_find_plane_for_view(fb) on the Pi 5 + 4K
        # display when the pointer entered a view. Pixman avoids that broken
        # hardware-plane import while retaining Wayland, DRM and libinput.
        WESTON_ARGS="--backend=drm-backend.so --renderer=pixman --shell=kiosk-shell.so --socket=$WAYLAND_DISPLAY --idle-time=0"
        if weston --help 2>&1 | grep -q -- '--continue-without-input'; then
            WESTON_ARGS="$WESTON_ARGS --continue-without-input"
        fi
        # shellcheck disable=SC2086
        weston $WESTON_ARGS >>"$WESTON_LOG" 2>&1 &
        WESTON_PID=$!
        # Weston may take several seconds to initialize GBM/EGL on a cold Pi.
        for _ in $(seq 1 300); do
            weston_state="$(ps -o stat= -p "$WESTON_PID" 2>/dev/null | tr -d '[:space:]')"
            # A Weston process can leave its socket behind for a short time
            # after aborting in the DRM backend.  A socket alone is therefore
            # not proof that a usable Wayland display exists.
            if [ -z "$weston_state" ] || [[ "$weston_state" == Z* ]]; then
                break
            fi
            [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && break
            sleep 0.1
        done
    fi
    weston_ready=false
    if [ -n "${WESTON_PID:-}" ]; then
        weston_state="$(ps -o stat= -p "$WESTON_PID" 2>/dev/null | tr -d '[:space:]')"
        if [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] &&
           [ -n "$weston_state" ] && [[ "$weston_state" != Z* ]]; then
            # Let the compositor finish its first repaint.  This catches the
            # Pi DRM assertion path that creates a socket before aborting.
            sleep 0.5
            weston_state="$(ps -o stat= -p "$WESTON_PID" 2>/dev/null | tr -d '[:space:]')"
            [ -n "$weston_state" ] && [[ "$weston_state" != Z* ]] && weston_ready=true
        fi
    elif [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && pgrep -x weston >/dev/null 2>&1; then
        # An already-running compositor may belong to the service wrapper.
        weston_ready=true
    fi
    if [ "$weston_ready" != true ]; then
        rm -f "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" \
            "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY.lock"
        printf '%s Weston failed; entering explicit recovery framebuffer path.\n' \
            "$(date -Iseconds)" >>"$UI_LOG"
        DISPLAY_BACKEND="linuxfb"
    fi
else
    printf '%s No DRM device found; entering explicit recovery framebuffer path.\n' \
        "$(date -Iseconds)" >>"$UI_LOG"
    DISPLAY_BACKEND="linuxfb"
fi

if [ "$DISPLAY_BACKEND" = "linuxfb" ]; then
    if [ ! -c /dev/fb0 ]; then
        echo "YUNSH: Wayland failed and no recovery framebuffer exists." >&2
        exit 1
    fi
    export QT_QPA_PLATFORM="linuxfb:fb=/dev/fb0"
    export QT_QUICK_BACKEND="software"
    printf '%s Using linuxfb only as explicit Wayland/DRM recovery.\n' \
        "$(date -Iseconds)" >>"$UI_LOG"
else
    [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] || {
        echo "YUNSH: Wayland compositor failed to start." >&2
        exit 1
    }
    export QT_QPA_PLATFORM="wayland"
    export QT_QUICK_BACKEND="software"
    printf '%s Using primary Wayland DRM compositor with Weston pixman renderer.\n' \
        "$(date -Iseconds)" >>"$UI_LOG"
fi

# Do not leave a connected display on a featureless black surface when the
# shell has a QML error.  A minimal, independent QML screen makes the failure
# self-describing on the device and preserves the detailed logs for support.
failure_count=0
while true; do
    if [ -f /etc/yunsh/.activated ]; then
        "$QML_RUNNER" main.qml -- --activated 2>>"$UI_LOG"
        QML_EXIT=$?
    else
        "$QML_RUNNER" main.qml -- --firstboot 2>>"$UI_LOG"
        QML_EXIT=$?
        if [ "$QML_EXIT" -eq 42 ]; then
            touch /etc/yunsh/.activated
            sync
            failure_count=0
            continue
        fi
    fi
    failure_count=$((failure_count + 1))
    printf '%s YUNSH UI exited with status %s (attempt %s)\n' \
        "$(date -Iseconds)" "$QML_EXIT" "$failure_count" >>"$UI_LOG"

    # Qt Quick can abort inside the Pi's accelerated Wayland scenegraph when a
    # pointer enters a layered/hovered item.  Keep the compositor and shell
    # alive, then retry once with the software scenegraph instead of exposing a
    # boot log and looping on the same GPU crash forever.
    if [ "$QML_EXIT" -ge 128 ] && [ "${QT_QUICK_BACKEND:-}" != "software" ]; then
        export QT_QUICK_BACKEND="software"
        printf '%s Qt Quick aborted; retrying with software scenegraph.\n' \
            "$(date -Iseconds)" >>"$UI_LOG"
    fi

    if [ "$failure_count" -ge 3 ] && [ -f "$RECOVERY_QML" ]; then
        "$QML_RUNNER" "$RECOVERY_QML" "$QML_EXIT" 2>>"$UI_LOG" || true
        failure_count=0
    fi
    # If the Wayland/Qt path repeatedly aborts (for example a broken DRM
    # plane import on pointer movement), switch once to the explicit recovery
    # framebuffer path. This is never selected during a healthy boot.
    if [ "$failure_count" -ge 3 ] && [ "$DISPLAY_BACKEND" = "wayland" ] &&
       [ -c /dev/fb0 ]; then
        [ -n "${WESTON_PID:-}" ] && kill "$WESTON_PID" 2>/dev/null || true
        rm -f "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" \
            "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY.lock"
        DISPLAY_BACKEND="linuxfb"
        export QT_QPA_PLATFORM="linuxfb:fb=/dev/fb0"
        export QT_QUICK_BACKEND="software"
        printf '%s Wayland/Qt crashed repeatedly; using linuxfb recovery.\n' \
            "$(date -Iseconds)" >>"$UI_LOG"
        failure_count=0
    fi
    sleep 2
done
