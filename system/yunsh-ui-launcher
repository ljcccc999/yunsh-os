#!/bin/bash
# YUNSH OS Qt Quick launcher on a Wayland compositor.
set -u

cd /usr/share/yunsh/ui || exit 1

export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
export QT_QUICK_CONTROLS_STYLE="${QT_QUICK_CONTROLS_STYLE:-Basic}"
export QTWEBENGINE_DISABLE_SANDBOX=1
# Keep WebGL available to browser pages.  The Pi 5 KMS path is the normal
# renderer; Chromium's blocklist is ignored only for this trusted local shell.
export QTWEBENGINE_CHROMIUM_FLAGS="${QTWEBENGINE_CHROMIUM_FLAGS:---no-sandbox --disable-dev-shm-usage --enable-gpu --enable-webgl --ignore-gpu-blocklist}"
export QML_XHR_ALLOW_FILE_READ=1
export QT_IM_MODULE="${QT_IM_MODULE:-fcitx}"
export GTK_IM_MODULE="${GTK_IM_MODULE:-fcitx}"
export XMODIFIERS="${XMODIFIERS:-@im=fcitx}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/yunsh-runtime}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
LOG_DIR="/var/log"
UI_LOG="${LOG_DIR}/yunsh-ui.log"
WESTON_LOG="${LOG_DIR}/yunsh-weston.log"
RECOVERY_QML="/usr/share/yunsh/ui/RecoveryScreen.qml"

install -d -m 0700 "$XDG_RUNTIME_DIR"
# Keep the graphical Fcitx5 profile deterministic: the globe key and the
# YUNSH menu both switch between the normal US layout and Pinyin.  The profile
# is created for the root-owned compositor session and for the fixed local
# account so a later desktop restart does not lose Chinese input.
for fcitx_home in /root /home/yunsh; do
    install -d -m 0700 "$fcitx_home/.config/fcitx5"
    if [ ! -f "$fcitx_home/.config/fcitx5/profile" ] ||
       ! grep -q '^Name=pinyin$' "$fcitx_home/.config/fcitx5/profile" 2>/dev/null; then
        cat > "$fcitx_home/.config/fcitx5/profile" <<'FCITX_PROFILE'
[Groups/0]
Name=Default
Default Layout=us
DefaultIM=keyboard-us

[Groups/0/Items/0]
Name=keyboard-us
Layout=us

[Groups/0/Items/1]
Name=pinyin
FCITX_PROFILE
        chmod 0600 "$fcitx_home/.config/fcitx5/profile"
    fi
done
# Fcitx is deliberately not started here.  Before Weston owns a real display
# there is no Wayland seat for its frontend; starting it early caused repeated
# "Failed to open wayland connection" crashes and made the boot log look like
# the shell itself had failed.  It is started once, after the compositor has
# passed its readiness checks, below.
install -d -o yunsh -g yunsh \
    /home/yunsh/Pictures/Screenshots /home/yunsh/Downloads \
    /home/yunsh/.cache/yunsh-browser /home/yunsh/.local/share/yunsh-browser \
    2>/dev/null || {
        install -d /home/yunsh/Pictures/Screenshots
        install -d /home/yunsh/Downloads
    }

if [ -x /usr/lib/qt6/bin/qml ]; then
    QML_RUNNER=/usr/lib/qt6/bin/qml
elif [ -x /usr/lib/qt6/bin/qmlscene ]; then
    QML_RUNNER=/usr/lib/qt6/bin/qmlscene
else
    QML_RUNNER="$(command -v qml6 || command -v qml || true)"
fi
if [ -z "$QML_RUNNER" ]; then
    echo "YUNSH: Qt QML runtime is not installed." >&2
    exit 1
fi

if [ ! -f /etc/yunsh/.packages_installed ]; then
    echo "YUNSH: First-boot setup has not completed." >&2
    exit 1
fi

# Every normal desktop start begins behind the local lock. This marker is
# intentionally independent of the Linux/SSH password and is cleared only by
# the QML unlock flow after the user has entered the local password.
if [ -f /etc/yunsh/.activated ]; then
    install -d -m 0700 /etc/yunsh
    printf 'required\n' > /etc/yunsh/boot-lock
    chmod 0600 /etc/yunsh/boot-lock
fi

/usr/bin/yunsh-disk-helper 2>/dev/null || true

# Waydroid requires a real Wayland session. Weston owns the display and
# composes both the YUNSH shell and Android surfaces on the same output. DRM
# KMS is the preferred compositor backend, while fbdev Weston is the
# compatibility bridge for a working framebuffer-only boot. Direct Qt linuxfb
# remains the final recovery path when no Wayland backend can be loaded.
if ! command -v weston >/dev/null 2>&1; then
    echo "YUNSH: Weston is not installed." >&2
    exit 1
fi
DISPLAY_BACKEND="wayland"
COMPOSITOR_BACKEND=""
DRM_DEVICE=""
# A missing DRM node is a hardware/display fault, not a reason to let
# systemd restart the whole shell every two seconds.  On the Pi 5 the node can
# appear a little after udev/firmware initialization, so wait in this single
# process and keep SSH/recovery responsive while it is unavailable.
display_wait_log=""
while :; do
    DRM_DEVICE=""
    if [ -d /dev/dri ]; then
        DRM_DEVICE="$(find /dev/dri -maxdepth 1 -type c -name 'card*' -print -quit 2>/dev/null || true)"
    fi
    if [ -n "$DRM_DEVICE" ] || [ -c /dev/fb0 ]; then
        break
    fi
    if [ -z "$display_wait_log" ] || [ "$display_wait_log" -le 0 ]; then
        printf '%s No DRM or framebuffer device; waiting without restarting the shell.\n' \
            "$(date -Iseconds)" >>"$UI_LOG"
        display_wait_log=12
    else
        display_wait_log=$((display_wait_log - 1))
    fi
    sleep 5
done

start_weston_backend() {
    local backend="$1"
    local weston_state=""
    local weston_args="--backend=$backend --renderer=pixman --shell=kiosk-shell.so --socket=$WAYLAND_DISPLAY --idle-time=0"

    # A compositor killed during startup can leave its socket behind.  A
    # socket alone is never accepted as a healthy display endpoint.
    if [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] &&
       ! pgrep -x weston >/dev/null 2>&1; then
        rm -f "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" \
            "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY.lock"
    fi
    if [ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
        # Weston versions shipped by Debian/Raspberry Pi OS do not all accept
        # this option. Passing an unsupported option makes Weston quit before
        # creating its socket, so add it only when advertised.
        if weston --help 2>&1 | grep -q -- '--continue-without-input'; then
            weston_args="$weston_args --continue-without-input"
        fi
        # shellcheck disable=SC2086
        weston $weston_args >>"$WESTON_LOG" 2>&1 &
        WESTON_PID=$!
        # Weston may take several seconds to initialize a cold display.
        for _ in $(seq 1 300); do
            weston_state="$(ps -o stat= -p "$WESTON_PID" 2>/dev/null | tr -d '[:space:]')"
            if [ -z "$weston_state" ] || [[ "$weston_state" == Z* ]]; then
                break
            fi
            [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] && break
            sleep 0.1
        done
    fi

    if [ -n "${WESTON_PID:-}" ]; then
        weston_state="$(ps -o stat= -p "$WESTON_PID" 2>/dev/null | tr -d '[:space:]')"
        if [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] &&
           [ -n "$weston_state" ] && [[ "$weston_state" != Z* ]]; then
            # Let the compositor finish its first repaint. This catches the
            # Pi DRM assertion path that can create a socket before aborting.
            sleep 0.5
            weston_state="$(ps -o stat= -p "$WESTON_PID" 2>/dev/null | tr -d '[:space:]')"
            [ -n "$weston_state" ] && [[ "$weston_state" != Z* ]] && return 0
        fi
    elif [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] &&
         pgrep -x weston >/dev/null 2>&1; then
        # An already-running compositor may belong to the service wrapper.
        return 0
    fi

    [ -n "${WESTON_PID:-}" ] && kill "$WESTON_PID" 2>/dev/null || true
    rm -f "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" \
        "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY.lock"
    return 1
}

if [ -n "$DRM_DEVICE" ]; then
    # Weston GL hit drm_output_find_plane_for_view(fb) on the Pi 5 + 4K
    # display when the pointer entered a view. Pixman avoids that broken
    # hardware-plane import while retaining Wayland, DRM and libinput.
    if start_weston_backend "drm-backend.so"; then
        COMPOSITOR_BACKEND="drm"
    else
        printf '%s Weston DRM failed; entering compatibility framebuffer path.\n' \
            "$(date -Iseconds)" >>"$UI_LOG"
        DISPLAY_BACKEND="linuxfb"
    fi
else
    printf '%s No DRM device found; trying Weston fbdev compatibility backend.\n' \
        "$(date -Iseconds)" >>"$UI_LOG"
    # Debian/Raspberry Pi OS builds that ship Weston commonly install this
    # module below libweston-*/.  Use the actual module path so the fallback
    # does not depend on a particular libweston ABI directory name.
    FBDEV_BACKEND="$(find /usr/lib /lib -type f -name 'fbdev-backend.so' -print -quit 2>/dev/null || true)"
    if [ -n "$FBDEV_BACKEND" ] && start_weston_backend "$FBDEV_BACKEND"; then
        COMPOSITOR_BACKEND="fbdev"
        printf '%s Using Weston fbdev Wayland compatibility backend.\n' \
            "$(date -Iseconds)" >>"$UI_LOG"
    else
        printf '%s Weston fbdev unavailable; entering explicit linuxfb recovery path.\n' \
            "$(date -Iseconds)" >>"$UI_LOG"
        DISPLAY_BACKEND="linuxfb"
    fi
fi

if [ "$DISPLAY_BACKEND" = "linuxfb" ]; then
    if [ ! -c /dev/fb0 ]; then
        printf '%s Wayland failed and no recovery framebuffer exists; retrying display detection.\n' \
            "$(date -Iseconds)" >>"$UI_LOG"
        sleep 10
        exec "$0"
    fi
    export QT_QPA_PLATFORM="linuxfb:fb=/dev/fb0"
    export QT_QUICK_BACKEND="software"
    printf '%s Using linuxfb only as explicit Wayland/DRM recovery.\n' \
        "$(date -Iseconds)" >>"$UI_LOG"
else
    [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] || {
        echo "YUNSH: Wayland compositor failed to start." >&2
        exit 1
    }
    export QT_QPA_PLATFORM="wayland"
    export QT_QUICK_BACKEND="software"
    if [ "$COMPOSITOR_BACKEND" = "fbdev" ]; then
        printf '%s Using Wayland with Weston fbdev compositor and pixman renderer.\n' \
            "$(date -Iseconds)" >>"$UI_LOG"
    else
        printf '%s Using primary Wayland DRM compositor with Weston pixman renderer.\n' \
            "$(date -Iseconds)" >>"$UI_LOG"
    fi
fi

# Fcitx must start after Weston has created the Wayland socket.  The previous
# early-start instance could load the pinyin addon but had no focused frontend,
# so letters appeared to do nothing.  Keep its private session-bus address and
# export it to the QML process so virtual-keyboard key events reach the same
# input-method instance.
pkill -x fcitx5 >/dev/null 2>&1 || true
install -d -m 0755 /run/yunsh
rm -f /run/yunsh/fcitx-env
if command -v dbus-run-session >/dev/null 2>&1; then
    dbus-run-session -- sh -c 'printf "DBUS_SESSION_BUS_ADDRESS=%s\\n" "$DBUS_SESSION_BUS_ADDRESS" > /run/yunsh/fcitx-env; exec fcitx5 --replace' >>"$UI_LOG" 2>&1 &
    for _ in $(seq 1 30); do
        [ -s /run/yunsh/fcitx-env ] && break
        sleep 0.1
    done
    [ -s /run/yunsh/fcitx-env ] && . /run/yunsh/fcitx-env
else
    fcitx5 -d --replace >>"$UI_LOG" 2>&1 &
fi
fcitx5-remote -s keyboard-us >/dev/null 2>&1 || true

# Do not leave a connected display on a featureless black surface when the
# shell has a QML error.  A minimal, independent QML screen makes the failure
# self-describing on the device and preserves the detailed logs for support.
failure_count=0
while true; do
    if [ -f /etc/yunsh/.activated ]; then
        "$QML_RUNNER" main.qml -- --activated 2>>"$UI_LOG"
        QML_EXIT=$?
    else
        "$QML_RUNNER" main.qml -- --firstboot 2>>"$UI_LOG"
        QML_EXIT=$?
        if [ "$QML_EXIT" -eq 42 ]; then
            touch /etc/yunsh/.activated
            sync
            failure_count=0
            continue
        fi
    fi
    failure_count=$((failure_count + 1))
    printf '%s YUNSH UI exited with status %s (attempt %s)\n' \
        "$(date -Iseconds)" "$QML_EXIT" "$failure_count" >>"$UI_LOG"

    # Qt Quick can abort inside the Pi's accelerated Wayland scenegraph when a
    # pointer enters a layered/hovered item.  Keep the compositor and shell
    # alive, then retry once with the software scenegraph instead of exposing a
    # boot log and looping on the same GPU crash forever.
    if [ "$QML_EXIT" -ge 128 ] && [ "${QT_QUICK_BACKEND:-}" != "software" ]; then
        export QT_QUICK_BACKEND="software"
        printf '%s Qt Quick aborted; retrying with software scenegraph.\n' \
            "$(date -Iseconds)" >>"$UI_LOG"
    fi

    # If the Wayland/Qt path repeatedly aborts (for example a broken DRM
    # plane import on pointer movement), switch once to the explicit recovery
    # framebuffer path. This is never selected during a healthy boot.
    if [ "$failure_count" -ge 3 ] && [ "$DISPLAY_BACKEND" = "wayland" ] &&
       [ -c /dev/fb0 ]; then
        [ -n "${WESTON_PID:-}" ] && kill "$WESTON_PID" 2>/dev/null || true
        rm -f "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" \
            "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY.lock"
        DISPLAY_BACKEND="linuxfb"
        export QT_QPA_PLATFORM="linuxfb:fb=/dev/fb0"
        export QT_QUICK_BACKEND="software"
        printf '%s Wayland/Qt crashed repeatedly; using linuxfb recovery.\n' \
            "$(date -Iseconds)" >>"$UI_LOG"
        failure_count=0
    elif [ "$failure_count" -ge 3 ] && [ -f "$RECOVERY_QML" ]; then
        "$QML_RUNNER" "$RECOVERY_QML" "$QML_EXIT" 2>>"$UI_LOG" || true
        failure_count=0
    fi
    sleep 2
done
