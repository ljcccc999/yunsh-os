#!/bin/bash
# YUNSH OS — Factory Reset
# iOS-style: keeps system, removes all user data + installed apps

set -e

RESET_VERSION="$(awk -F= '$1 == "VERSION" {print $2; exit}' /etc/yunsh/version.conf 2>/dev/null)"
[ -n "$RESET_VERSION" ] || RESET_VERSION="current"
echo "YUNSH OS ${RESET_VERSION} — 恢复出厂设置"
echo ""

# First desktop boot may still be preparing optional media, voice or Android
# packages.  Factory reset must never reboot in the middle of dpkg: systemd
# will reject the reboot (or a forced reboot can damage the package database).
# New installers share this lock; the explicit dpkg/debconf checks also make
# reset safe on systems upgraded from an older release.
install -d -m 0755 /run/lock
exec 9>/run/lock/yunsh-package-setup.lock
if command -v flock >/dev/null 2>&1 && ! flock -w 1900 9; then
    echo "✗ 后台组件仍在安装，请稍后重试恢复出厂设置" >&2
    exit 1
fi
for package_lock in /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/cache/debconf/config.dat; do
    wait_count=0
    while command -v fuser >/dev/null 2>&1 && fuser "$package_lock" >/dev/null 2>&1; do
        [ "$wait_count" -eq 0 ] && echo "… 正在等待后台系统安装安全完成"
        wait_count=$((wait_count + 1))
        if [ "$wait_count" -ge 1900 ]; then
            echo "✗ 软件包管理器长时间忙碌，恢复出厂设置尚未执行" >&2
            exit 1
        fi
        sleep 1
    done
done

[ -x /usr/bin/yunsh-recordingd ] && /usr/bin/yunsh-recordingd stop >/dev/null 2>&1 || true

# ─── Remove activation flag (shows wizard on next boot) ───
rm -f /etc/yunsh/.activated
rm -f /etc/yunsh/.firstboot_partial
rm -f /var/lib/yunsh/firstboot-progress
echo "✓ 激活状态已重置"

# ─── Keep system flags & config (don't reinstall system) ───
# /etc/yunsh/.packages_installed — preserved
# /etc/yunsh/version.conf — preserved (system stays same version)
# /etc/yunsh/update.conf — preserved (OTA settings kept)

# ─── Delete user-installed app data (iOS style: apps + their data) ───
rm -rf /home/yunsh/.local/share 2>/dev/null || true
rm -rf /home/yunsh/.config 2>/dev/null || true
rm -rf /home/yunsh/.cache /home/yunsh/.ssh 2>/dev/null || true
rm -f /home/yunsh/.bash_history /home/yunsh/.python_history 2>/dev/null || true
echo "✓ 用户应用数据已清除"

# ─── Delete screenshots & user files ───
rm -rf /home/yunsh/Pictures 2>/dev/null || true
rm -rf /home/yunsh/Videos 2>/dev/null || true
rm -rf /home/yunsh/Documents 2>/dev/null || true
rm -rf /home/yunsh/Desktop 2>/dev/null || true
rm -rf /home/yunsh/Downloads 2>/dev/null || true
echo "✓ 用户文件（截图/文档）已清除"

# Keep the built-in yunsh account. Removing it would require first-boot setup
# to run again, which factory reset must never do.
if ! id -u yunsh >/dev/null 2>&1; then
    useradd -m -s /bin/bash -G sudo,adm,dialout yunsh
fi
usermod -aG sudo,adm,dialout yunsh
install -d -o yunsh -g yunsh /home/yunsh
echo "yunsh:yunsh123" | chpasswd
echo "✓ 系统账号已保留；本机密码已重置"

# ─── Reset user settings (language, Wi-Fi, Bluetooth) ───
# Only remove user-preference files, keep system config
rm -f /etc/yunsh/language.conf 2>/dev/null || true
rm -f /etc/yunsh/region.conf 2>/dev/null || true
rm -f /etc/yunsh/glasses.conf 2>/dev/null || true
rm -f /etc/yunsh/spatial-display.json 2>/dev/null || true
rm -f /etc/yunsh/comfort-dna.json 2>/dev/null || true
rm -f /etc/yunsh/account.json 2>/dev/null || true
rm -rf /etc/yunsh/orbit 2>/dev/null || true
rm -rf /var/lib/yunsh/orbit/memory 2>/dev/null || true
rm -rf /var/lib/yunsh/orbit/screen 2>/dev/null || true
rm -f /var/lib/yunsh/orbit/current-plan.json 2>/dev/null || true
rm -f /etc/yunsh/link-trust.json /etc/yunsh/space-transfer.crt /etc/yunsh/space-transfer.key 2>/dev/null || true
rm -rf /var/lib/yunsh/space-inbox 2>/dev/null || true
rm -f /run/yunsh/link-pairing.json 2>/dev/null || true
if command -v nmcli >/dev/null 2>&1; then
    timeout 10 nmcli -t -e yes -f UUID,TYPE connection show 2>/dev/null |
    while IFS=: read -r connection_uuid connection_type; do
        [ "$connection_type" = "802-11-wireless" ] &&
            nmcli connection delete uuid "$connection_uuid" >/dev/null 2>&1 || true
    done
fi
if command -v bluetoothctl >/dev/null 2>&1; then
    timeout 10 bluetoothctl paired-devices 2>/dev/null | awk '/^Device / {print $2}' |
    while read -r address; do
        timeout 5 bluetoothctl remove "$address" >/dev/null 2>&1 || true
    done
fi
# Keep: version.conf, update.conf, .packages_installed
echo "✓ 用户偏好已重置（保留系统配置）"

# ─── Waydroid: remove all installed Android apps + data ───
if command -v waydroid &>/dev/null; then
    timeout 10 waydroid session stop 2>/dev/null || true
fi
timeout 10 systemctl stop waydroid-container.service 2>/dev/null || true
if [ -d /var/lib/waydroid/data ]; then
    find /var/lib/waydroid/data -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + 2>/dev/null || true
fi
rm -f /var/lib/yunsh/.tencent-appstore-installed 2>/dev/null || true
rm -f /var/lib/yunsh/.fdroid-installed 2>/dev/null || true
# Preserve Android system images/rootfs so no reinstall or redownload is needed.
echo "✓ Waydroid 用户数据已清除（系统镜像保留）"

# ─── Clear caches and temp ───
rm -rf /root/.cache 2>/dev/null || true
# Remove temp files but NOT sockets or running process IPC
# Safer: use -exec rm -rf {} + with proper socket exclusion
# Remove only transient files created by YUNSH.  A factory reset must not
# delete unrelated software's runtime data merely because it shares /tmp.
rm -f /tmp/yunsh-clipboard.png /tmp/yunsh-*-status.json /tmp/yunsh-*-result.json \
      /tmp/yunsh-ui-command.json /tmp/yunsh-ui-state.json \
      /tmp/yunsh-glasses-control.json /tmp/yunsh-update.sock \
      /tmp/yunsh-network.sock 2>/dev/null || true
find /tmp -maxdepth 1 -type f -name 'yunsh-screenshot-region-full-*.png' -delete 2>/dev/null || true
find /tmp -maxdepth 1 -type d -name 'yunsh-screenshot.*' -prune -exec rm -rf {} + 2>/dev/null || true
echo "✓ 系统缓存已清理"

# ─── Clear logs ───
: > /var/log/yunsh-update.log 2>/dev/null || true
: > /var/log/yunsh-network.log 2>/dev/null || true
: > /var/log/yunsh-bluetooth.log 2>/dev/null || true
echo "✓ 日志已清理"

echo ""
echo "✅ 恢复出厂设置完成！"
echo "系统版本保持 v$(cat /etc/yunsh/version.conf 2>/dev/null | grep VERSION | cut -d= -f2 | tr -d 'v' || echo "?")"
echo "重新启动后将进入激活向导"
echo ""

sleep 2
systemctl reboot -i --no-wall
